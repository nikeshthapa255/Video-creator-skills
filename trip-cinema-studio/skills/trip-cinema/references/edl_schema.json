{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-cinema-studio.local/schemas/edl.schema.json",
  "title": "Trip Cinema Studio Edit Decision List (EDL)",
  "type": "object",
  "required": [
    "version",
    "resolution",
    "fps",
    "color_look",
    "vertical_layout",
    "bgm",
    "chapters",
    "shots"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "description": "Film title derived from trip dates/locations."
    },
    "resolution": {
      "type": "string",
      "enum": ["1920x1080", "3840x2160"],
      "default": "1920x1080"
    },
    "fps": {
      "type": "number",
      "enum": [24, 29.97, 30, 60],
      "default": 30
    },
    "color_look": {
      "type": "string",
      "enum": ["warm_film", "moody_teal_orange", "clean_natural", "soft_atmospheric"]
    },
    "vertical_layout": {
      "type": "string",
      "enum": ["split_diptych_pair", "blurred_bg_pillarbox"]
    },
    "budget_mode": {
      "type": "string",
      "enum": ["local_zero_cost", "hybrid_i2v"]
    },
    "i2v_cost_cap_usd": {
      "type": "number",
      "minimum": 0
    },
    "bgm": {
      "type": "object",
      "required": ["audio_path", "target_lufs", "target_lra"],
      "properties": {
        "audio_path": { "type": "string" },
        "source_type": { "type": "string", "enum": ["cc0", "lyria_3_5", "user_local"] },
        "bpm": { "type": "number", "minimum": 30, "maximum": 240 },
        "target_lufs": { "type": "number", "const": -14 },
        "target_lra": { "type": "number", "const": 9 },
        "beat_map_path": { "type": "string" }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chapter_id", "title", "start_date"],
        "properties": {
          "chapter_id": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "eyebrow": {
            "type": "string",
            "description": "Short editorial eyebrow label above the chapter title (e.g., 'DAY 01 · TOKYO')."
          },
          "backdrop_path": {
            "type": "string",
            "description": "Hero photo path from this chapter used as a softly blurred, vignetted, slow-zooming backdrop for the editorial chapter card (never a plain black slide)."
          },
          "start_date": { "type": "string" },
          "gps_waypoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["lat", "lon"],
              "properties": {
                "lat": { "type": "number" },
                "lon": { "type": "number" },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "chapter_id",
          "source_path",
          "media_type",
          "in_sec",
          "out_sec",
          "duration_sec",
          "motion_type",
          "has_human_closeup",
          "locked_by_user"
        ],
        "properties": {
          "shot_id": { "type": "string" },
          "chapter_id": { "type": "string" },
          "source_path": { "type": "string" },
          "pair_source_path": {
            "type": "string",
            "description": "Second vertical photo path when aspect_handling is split_diptych_pair."
          },
          "aspect_handling": {
            "type": "string",
            "enum": ["split_diptych_pair", "blurred_bg_pillarbox"]
          },
          "media_type": {
            "type": "string",
            "enum": ["photo", "video"]
          },
          "orientation": {
            "type": "string",
            "enum": ["landscape", "portrait", "square"]
          },
          "in_sec": { "type": "number", "minimum": 0 },
          "out_sec": { "type": "number", "minimum": 0 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "source_duration_sec": { "type": "number", "minimum": 0 },
          "use_i2v": { "type": "boolean", "default": false },
          "motion_type": {
            "type": "string",
            "enum": [
              "native_video",
              "vidstab_video",
              "ken_burns_in",
              "ken_burns_out",
              "ken_burns_pan",
              "depth_parallax_2_5d",
              "omni_i2v_scenic"
            ]
          },
          "focal_anchor": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "has_human_closeup": {
            "type": "boolean",
            "description": "Must be false whenever motion_type is omni_i2v_scenic."
          },
          "locked_by_user": { "type": "boolean" },
          "stabilize": { "type": "boolean", "default": false },
          "transition": {
            "type": "string",
            "enum": ["cut", "xfade_dissolve", "j_cut", "l_cut"],
            "default": "cut"
          },
          "overlay": {
            "type": "string",
            "enum": ["none", "chapter_title", "route_map"],
            "default": "none"
          },
          "eyebrow": {
            "type": "string",
            "description": "Short editorial eyebrow label rendered above the chapter/title card heading."
          },
          "backdrop_path": {
            "type": "string",
            "description": "Hero photo path from the chapter used as a softly blurred, vignetted, slow-zooming backdrop for visual editorial chapter cards (never flat black slides)."
          },
          "fade_in": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Fade-in duration in seconds."
          },
          "fade_out": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Fade-out duration in seconds."
          }
        }
      }
    }
  }
}
