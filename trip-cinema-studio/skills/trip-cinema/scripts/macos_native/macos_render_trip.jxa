#!/usr/bin/env osascript -l JavaScript
/**
 * Zero-dependency macOS Native 16:9 Master Renderer.
 * Uses AVFoundation + CoreImage + AppKit (100% Apple-signed).
 *
 * Low-impact macOS protections:
 *   - Pre-downscales >2400px stills ONCE per shot before Ken Burns loop
 *   - Micro-yield + NSRunLoop drain every 2 frames so macOS UI stays responsive
 *   - Chapter-by-chapter batching:
 *       --start-shot <idx> --end-shot <excl> --video-only
 *       --mux-segments <seg1.mp4,seg2.mp4,...> --edl <edl.json> --output <final.mp4>
 *   - Status polling for AVAssetWriter (status === 1) & AVAssetExportSession (status === 1 || 2)
 */

ObjC.import("Foundation");
ObjC.import("AVFoundation");
ObjC.import("CoreImage");
ObjC.import("CoreMedia");
ObjC.import("CoreVideo");
ObjC.import("CoreAudio");
ObjC.import("ImageIO");
ObjC.import("AppKit");
ObjC.import("CoreGraphics");

function avClass(name) {
  const cls = $.NSClassFromString(name);
  if (!cls) throw new Error("AVFoundation class not found: " + name);
  return cls;
}

function parseArgs(argv) {
  const args = {
    edl: null,
    output: "./output/trip_cinema.mp4",
    width: 1920,
    height: 1080,
    fps: 30,
    startShot: null,
    endShot: null,
    videoOnly: false,
    muxSegments: null,
    dryRun: false,
    help: false,
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--help" || a === "-h") args.help = true;
    else if (a === "--edl") args.edl = argv[++i];
    else if (a === "--output" || a === "-o") args.output = argv[++i];
    else if (a === "--width") args.width = parseInt(argv[++i], 10) || 1920;
    else if (a === "--height") args.height = parseInt(argv[++i], 10) || 1080;
    else if (a === "--fps") args.fps = parseInt(argv[++i], 10) || 30;
    else if (a === "--start-shot") args.startShot = parseInt(argv[++i], 10);
    else if (a === "--end-shot") args.endShot = parseInt(argv[++i], 10);
    else if (a === "--video-only") args.videoOnly = true;
    else if (a === "--mux-segments") args.muxSegments = argv[++i].split(",").map((s) => s.trim()).filter(Boolean);
    else if (a === "--dry-run") args.dryRun = true;
  }
  return args;
}

function readJsonFile(path) {
  const nsStr = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
  if (!nsStr) throw new Error("Failed to read JSON: " + path);
  return JSON.parse(ObjC.unwrap(nsStr));
}

function ensureParentDir(filePath) {
  const parent = $(filePath).stringByDeletingLastPathComponent;
  $.NSFileManager.defaultManager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
    parent,
    true,
    $({}),
    null
  );
}

function logProgress(logPath, msg) {
  const line = "[" + new Date().toISOString() + "] " + msg + "\n";
  const data = $(line).dataUsingEncoding($.NSUTF8StringEncoding);
  $.NSFileHandle.fileHandleWithStandardError.writeData(data);
  if (logPath) {
    try {
      const fm = $.NSFileManager.defaultManager;
      if (fm.fileExistsAtPath(logPath)) {
        const fh = $.NSFileHandle.fileHandleForWritingAtPath(logPath);
        if (fh && typeof fh.seekToEndOfFile !== "undefined") {
          fh.seekToEndOfFile;
          fh.writeData(data);
          fh.closeFile;
          return;
        }
      }
      $(line).writeToFileAtomicallyEncodingError(logPath, true, $.NSUTF8StringEncoding, null);
    } catch (e) {
      // Never fail render on progress log write
    }
  }
}

function normalizeOrigin(ciImg) {
  const ext = ciImg.extent;
  if (ext.origin.x !== 0 || ext.origin.y !== 0) {
    return ciImg.imageByApplyingTransform($.CGAffineTransformMakeTranslation(-ext.origin.x, -ext.origin.y));
  }
  return ciImg;
}

function loadOrientedCIImage(ciCtx, filePath, maxDim) {
  const limit = maxDim || 2400;
  const url = $.NSURL.fileURLWithPath(filePath);
  const opts = $.NSMutableDictionary.dictionary;
  opts.setObjectForKey($.NSNumber.numberWithBool(true), $.kCIImageApplyOrientationProperty);
  let img = $.CIImage.imageWithContentsOfURLOptions(url, opts);
  if (!img) throw new Error("Failed to load image: " + filePath);
  img = normalizeOrigin(img);

  const w = img.extent.size.width;
  const h = img.extent.size.height;
  const maxSide = Math.max(w, h);
  if (maxSide > limit) {
    const scale = limit / maxSide;
    const lanczos = $.CIFilter.filterWithName("CILanczosScaleTransform");
    lanczos.setValueForKey(img, "inputImage");
    lanczos.setValueForKey(scale, "inputScale");
    lanczos.setValueForKey(1.0, "inputAspectRatio");
    let scaled = normalizeOrigin(lanczos.outputImage);
    const outW = Math.max(1, Math.round(w * scale));
    const outH = Math.max(1, Math.round(h * scale));
    if (ciCtx && typeof ciCtx.createCGImageFromRect === "function") {
      const cg = ciCtx.createCGImageFromRect(scaled, $.CGRectMake(0, 0, outW, outH));
      if (cg) {
        return $.CIImage.imageWithCGImage(cg);
      }
    }
    return scaled;
  }
  return img;
}

function aspectFillAndCrop(ciImg, targetW, targetH) {
  const ext = ciImg.extent;
  const scale = Math.max(targetW / ext.size.width, targetH / ext.size.height);
  let out = ciImg.imageByApplyingTransform($.CGAffineTransformMakeScale(scale, scale));
  const scaledW = ext.size.width * scale;
  const scaledH = ext.size.height * scale;
  const cropX = (scaledW - targetW) / 2.0;
  const cropY = (scaledH - targetH) / 2.0;
  out = out.imageByCroppingToRect($.CGRectMake(cropX, cropY, targetW, targetH));
  return out.imageByApplyingTransform($.CGAffineTransformMakeTranslation(-cropX, -cropY));
}

function aspectFitCentered(ciImg, targetW, targetH, zoomFactor) {
  const z = zoomFactor || 1.0;
  const ext = ciImg.extent;
  const scale = Math.min(targetW / ext.size.width, targetH / ext.size.height) * z;
  let out = ciImg.imageByApplyingTransform($.CGAffineTransformMakeScale(scale, scale));
  const dx = (targetW - ext.size.width * scale) / 2.0;
  const dy = (targetH - ext.size.height * scale) / 2.0;
  out = out.imageByApplyingTransform($.CGAffineTransformMakeTranslation(dx, dy));
  return out.imageByCroppingToRect($.CGRectMake(0, 0, targetW, targetH));
}

function applyLookFilter(ciImg, lookId) {
  if (lookId === "warm_film") {
    const c = $.CIFilter.filterWithName("CIColorControls");
    c.setValueForKey(ciImg, "inputImage");
    c.setValueForKey(1.06, "inputContrast");
    c.setValueForKey(1.08, "inputSaturation");
    c.setValueForKey(0.01, "inputBrightness");
    const t = $.CIFilter.filterWithName("CITemperatureAndTint");
    t.setValueForKey(c.outputImage, "inputImage");
    t.setValueForKey($.CIVector.vectorWithXY(6500, 0), "inputNeutral");
    t.setValueForKey($.CIVector.vectorWithXY(5600, 8), "inputTargetNeutral");
    return t.outputImage;
  }
  if (lookId === "moody_teal_orange") {
    const c = $.CIFilter.filterWithName("CIColorControls");
    c.setValueForKey(ciImg, "inputImage");
    c.setValueForKey(1.14, "inputContrast");
    c.setValueForKey(1.04, "inputSaturation");
    c.setValueForKey(-0.02, "inputBrightness");
    const t = $.CIFilter.filterWithName("CITemperatureAndTint");
    t.setValueForKey(c.outputImage, "inputImage");
    t.setValueForKey($.CIVector.vectorWithXY(6500, 0), "inputNeutral");
    t.setValueForKey($.CIVector.vectorWithXY(7100, -10), "inputTargetNeutral");
    return t.outputImage;
  }
  if (lookId === "soft_atmospheric") {
    const c = $.CIFilter.filterWithName("CIColorControls");
    c.setValueForKey(ciImg, "inputImage");
    c.setValueForKey(0.93, "inputContrast");
    c.setValueForKey(0.90, "inputSaturation");
    c.setValueForKey(0.03, "inputBrightness");
    return c.outputImage;
  }
  const c = $.CIFilter.filterWithName("CIColorControls");
  c.setValueForKey(ciImg, "inputImage");
  c.setValueForKey(1.03, "inputContrast");
  c.setValueForKey(1.03, "inputSaturation");
  return c.outputImage;
}

function applyFadeOverlay(ciImg, fIdx, numFrames, fps, fadeInSec, fadeOutSec, width, height) {
  const t = fIdx / fps;
  const dur = numFrames / fps;
  let alpha = 1.0;
  if (fadeInSec > 0 && t < fadeInSec) alpha = Math.min(alpha, t / fadeInSec);
  if (fadeOutSec > 0 && dur - t < fadeOutSec) alpha = Math.min(alpha, Math.max(0.0, (dur - t) / fadeOutSec));
  if (alpha >= 0.999) return ciImg;

  const dark = $.CIFilter.filterWithName("CIColorControls");
  dark.setValueForKey(ciImg, "inputImage");
  dark.setValueForKey(-(1.0 - alpha), "inputBrightness");
  return dark.outputImage.imageByCroppingToRect($.CGRectMake(0, 0, width, height));
}

function renderKenBurnsFrame(ciImg, progress, anchor, dir, width, height) {
  const fx = Math.min(0.95, Math.max(0.05, anchor && anchor[0] !== undefined ? Number(anchor[0]) : 0.5));
  const fy = Math.min(0.95, Math.max(0.05, anchor && anchor[1] !== undefined ? Number(anchor[1]) : 0.5));
  const zoom = dir === "out" ? 1.14 - 0.14 * progress : 1.0 + 0.14 * progress;

  const ext = ciImg.extent;
  const baseScale = Math.max(width / ext.size.width, height / ext.size.height) * zoom;
  let scaled = ciImg.imageByApplyingTransform($.CGAffineTransformMakeScale(baseScale, baseScale));
  const sW = ext.size.width * baseScale;
  const sH = ext.size.height * baseScale;
  const cropX = Math.max(0, Math.min(sW - width, (sW - width) * fx));
  const cropY = Math.max(0, Math.min(sH - height, (sH - height) * (1.0 - fy)));
  scaled = scaled.imageByCroppingToRect($.CGRectMake(cropX, cropY, width, height));
  return scaled.imageByApplyingTransform($.CGAffineTransformMakeTranslation(-cropX, -cropY));
}

function renderPortraitComposite(imgA, imgB, handling, progress, width, height) {
  const bgBlack = $.CIImage.imageWithColor($.CIColor.colorWithRedGreenBlueAlpha(0.05, 0.05, 0.07, 1.0))
    .imageByCroppingToRect($.CGRectMake(0, 0, width, height));
  const gentleZoom = 1.0 + 0.04 * (progress || 0.0);

  if (handling === "split_diptych_pair" && imgB) {
    const halfW = Math.floor(width / 2) - 4;
    const left = aspectFillAndCrop(imgA, halfW, height);
    const right = aspectFillAndCrop(imgB, halfW, height).imageByApplyingTransform(
      $.CGAffineTransformMakeTranslation(Math.floor(width / 2) + 4, 0)
    );
    const combined = right.imageByCompositingOverImage(left.imageByCompositingOverImage(bgBlack));
    return renderKenBurnsFrame(combined, progress * 0.3, [0.5, 0.5], "in", width, height);
  }

  const blur = $.CIFilter.filterWithName("CIGaussianBlur");
  blur.setValueForKey(aspectFillAndCrop(imgA, width, height).imageByClampingToExtent, "inputImage");
  blur.setValueForKey(28.0, "inputRadius");
  const dark = $.CIFilter.filterWithName("CIColorControls");
  dark.setValueForKey(blur.outputImage.imageByCroppingToRect($.CGRectMake(0, 0, width, height)), "inputImage");
  dark.setValueForKey(-0.15, "inputBrightness");

  const fg = aspectFitCentered(imgA, width, height, gentleZoom);
  return fg.imageByCompositingOverImage(dark.outputImage);
}

function easeOutCubic(t) {
  const c = Math.min(1.0, Math.max(0.0, t));
  return 1.0 - Math.pow(1.0 - c, 3);
}

function easeInOutCubic(t) {
  const c = Math.min(1.0, Math.max(0.0, t));
  return c < 0.5 ? 4 * c * c * c : 1.0 - Math.pow(-2 * c + 2, 3) / 2;
}

function resolveSerifFont(size) {
  const candidates = ["Baskerville-SemiBold", "Georgia-Bold", "TimesNewRomanPS-BoldMT"];
  for (let i = 0; i < candidates.length; i++) {
    const f = $.NSFont.fontWithNameSize(candidates[i], size);
    if (f) return f;
  }
  return $.NSFont.systemFontOfSizeWeight(size, $.NSFontWeightBold);
}

function buildCardBackdropCI(backdropImg, progress, blurRadius, lookId, width, height) {
  const zoom = 1.02 + 0.07 * progress;
  const ext = backdropImg.extent;
  const scale = Math.max(width / ext.size.width, height / ext.size.height) * zoom;
  let scaled = backdropImg.imageByApplyingTransform($.CGAffineTransformMakeScale(scale, scale));
  const sW = ext.size.width * scale;
  const sH = ext.size.height * scale;
  const cropX = (sW - width) * 0.5;
  const cropY = (sH - height) * 0.5;
  scaled = scaled.imageByCroppingToRect($.CGRectMake(cropX, cropY, width, height));
  scaled = scaled.imageByApplyingTransform($.CGAffineTransformMakeTranslation(-cropX, -cropY));

  const blur = $.CIFilter.filterWithName("CIGaussianBlur");
  blur.setValueForKey(scaled.imageByClampingToExtent, "inputImage");
  blur.setValueForKey(blurRadius, "inputRadius");
  let blurred = blur.outputImage.imageByCroppingToRect($.CGRectMake(0, 0, width, height));
  return applyLookFilter(blurred, lookId);
}

function drawCardScrim(width, height, hasBackdrop) {
  if (!hasBackdrop) {
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.055, 0.062, 0.078, 1.0).setFill;
    $.NSBezierPath.fillRect($.NSMakeRect(0, 0, width, height));
    return;
  }
  // Dark charcoal-warm base scrim (~58% opacity) so typography pops cleanly
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.055, 0.052, 0.060, 0.58).setFill;
  $.NSBezierPath.fillRect($.NSMakeRect(0, 0, width, height));

  // Stronger edge vignette (non-variadic NSGradient initializer for JXA)
  const vigGrad = $.NSGradient.alloc.initWithStartingColorEndingColor(
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.04, 0.04, 0.05, 0.0),
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.03, 0.03, 0.04, 0.58)
  );
  if (vigGrad) {
    vigGrad.drawFromCenterRadiusToCenterRadiusOptions(
      $.NSMakePoint(width * 0.5, height * 0.5),
      height * 0.25,
      $.NSMakePoint(width * 0.5, height * 0.5),
      Math.max(width, height) * 0.65,
      $.NSGradientDrawsAfterEndingLocation
    );
  }
}

function makeTextShadow() {
  const shadow = $.NSShadow.alloc.init;
  shadow.shadowOffset = $.NSMakeSize(0, -3);
  shadow.shadowBlurRadius = 16.0;
  shadow.shadowColor = $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.0, 0.0, 0.0, 0.65);
  return shadow;
}

function makeTextAttrs(font, color, shadow) {
  const d = $.NSMutableDictionary.dictionary;
  if (font) d.setObjectForKey(font, $.NSFontAttributeName);
  if (color) d.setObjectForKey(color, $.NSForegroundColorAttributeName);
  if (shadow) d.setObjectForKey(shadow, $.NSShadowAttributeName);
  return d;
}

function drawEditorialCardOverlay(shot, progress, width, height) {
  const gold = $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 1.0); // #E8C58E
  const goldBorder = $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.28);
  const shadow = makeTextShadow();

  // Subtle 48px inset framing border
  const framePath = $.NSBezierPath.bezierPathWithRect($.NSMakeRect(48, 48, width - 96, height - 96));
  framePath.lineWidth = 1.5;
  goldBorder.setStroke;
  framePath.stroke;

  // Eyebrow (slides up gently during first 20% of progress)
  if (shot.eyebrow) {
    const eyeEase = easeOutCubic(Math.min(1.0, progress / 0.20));
    const eyeYOff = (1.0 - eyeEase) * -14.0;
    const eyeAttrs = makeTextAttrs(
      $.NSFont.systemFontOfSizeWeight(20, $.NSFontWeightMedium),
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, eyeEase),
      shadow
    );
    const eyeStr = String(shot.eyebrow);
    const eSize = $(eyeStr).sizeWithAttributes(eyeAttrs);
    $(eyeStr).drawAtPointWithAttributes(
      $.NSMakePoint((width - eSize.width) / 2, height * 0.60 + eyeYOff),
      eyeAttrs
    );
  }

  // Main serif title (cubic ease-out)
  const titleEase = easeOutCubic(Math.min(1.0, progress / 0.28));
  const titleYOff = (1.0 - titleEase) * -18.0;
  const titleStr = shot.title || "Chapter";
  const tAttrs = makeTextAttrs(
    resolveSerifFont(74),
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.98, 0.97, 0.95, titleEase),
    shadow
  );
  const tSize = $(titleStr).sizeWithAttributes(tAttrs);
  $(titleStr).drawAtPointWithAttributes(
    $.NSMakePoint((width - tSize.width) / 2, height * 0.48 + titleYOff),
    tAttrs
  );

  // Animated horizontal gold hairline divider expanding symmetrically from center (0 -> 220px)
  const lineEase = easeOutCubic(Math.max(0.0, (progress - 0.08) / 0.28));
  const lineW = 220.0 * lineEase;
  if (lineW > 1.0) {
    const divPath = $.NSBezierPath.bezierPath;
    divPath.lineWidth = 1.5;
    const divY = height * 0.445;
    divPath.moveToPoint($.NSMakePoint((width - lineW) / 2, divY));
    divPath.lineToPoint($.NSMakePoint((width + lineW) / 2, divY));
    gold.setStroke;
    divPath.stroke;
  }

  // Subtitle / coordinates line (#EAE4D9 at 0.88 alpha)
  const subStr = [shot.date_label, shot.coordinates_label].filter(Boolean).join("  ·  ");
  if (subStr) {
    const subEase = easeOutCubic(Math.max(0.0, (progress - 0.12) / 0.28));
    const sAttrs = makeTextAttrs(
      $.NSFont.systemFontOfSizeWeight(24, $.NSFontWeightRegular),
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.918, 0.894, 0.851, 0.88 * subEase),
      shadow
    );
    const sSize = $(subStr).sizeWithAttributes(sAttrs);
    $(subStr).drawAtPointWithAttributes(
      $.NSMakePoint((width - sSize.width) / 2, height * 0.375),
      sAttrs
    );
  }
}

function quadBezierPoint(p0, ctrl, p1, t) {
  const u = 1.0 - t;
  return {
    x: u * u * p0.x + 2 * u * t * ctrl.x + t * t * p1.x,
    y: u * u * p0.y + 2 * u * t * ctrl.y + t * t * p1.y,
  };
}

function drawRouteMapOverlay(shot, progress, width, height) {
  const wps = shot.waypoints;
  const shadow = makeTextShadow();

  // Faint latitude/longitude architectural grid lines
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.07).setStroke;
  for (let gx = 160; gx < width; gx += 160) {
    const p = $.NSBezierPath.bezierPath;
    p.lineWidth = 1.0;
    p.moveToPoint($.NSMakePoint(gx, 48));
    p.lineToPoint($.NSMakePoint(gx, height - 48));
    p.stroke;
  }
  for (let gy = 135; gy < height; gy += 135) {
    const p = $.NSBezierPath.bezierPath;
    p.lineWidth = 1.0;
    p.moveToPoint($.NSMakePoint(48, gy));
    p.lineToPoint($.NSMakePoint(width - 48, gy));
    p.stroke;
  }

  // Subtle 48px inset framing border
  const framePath = $.NSBezierPath.bezierPathWithRect($.NSMakeRect(48, 48, width - 96, height - 96));
  framePath.lineWidth = 1.5;
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.25).setStroke;
  framePath.stroke;

  // Optional header title (44pt serif white + gold underline)
  if (shot.title) {
    const hAttrs = makeTextAttrs(
      resolveSerifFont(44),
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.98, 0.97, 0.95, 0.96),
      shadow
    );
    $(shot.title).drawAtPointWithAttributes($.NSMakePoint(96, height - 126), hAttrs);
    const uPath = $.NSBezierPath.bezierPath;
    uPath.lineWidth = 1.5;
    uPath.moveToPoint($.NSMakePoint(96, height - 138));
    uPath.lineToPoint($.NSMakePoint(236, height - 138));
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.85).setStroke;
    uPath.stroke;
  }

  const padX = 320;
  const padY = 230;
  const lats = wps.map((w) => w.lat);
  const lons = wps.map((w) => w.lon);
  const minLat = Math.min.apply(null, lats);
  const maxLat = Math.max.apply(null, lats);
  const minLon = Math.min.apply(null, lons);
  const maxLon = Math.max.apply(null, lons);
  const latSpan = Math.max(0.01, maxLat - minLat);
  const lonSpan = Math.max(0.01, maxLon - minLon);

  const pts = wps.map((w) => ({
    label: w.label || "",
    subtitle: w.subtitle || "",
    x: padX + ((w.lon - minLon) / lonSpan) * (width - padX * 2),
    y: padY + ((w.lat - minLat) / latSpan) * (height - padY * 2),
  }));

  // Subtle concentric topographic/radar rings around each stop
  for (let i = 0; i < pts.length; i++) {
    const radii = [24, 44, 66];
    for (let rIdx = 0; rIdx < radii.length; rIdx++) {
      const r = radii[rIdx];
      const ring = $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(pts[i].x - r, pts[i].y - r, r * 2, r * 2));
      ring.lineWidth = 1.0;
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.14 - rIdx * 0.035).setStroke;
      ring.stroke;
    }
  }

  const numSegs = Math.max(1, pts.length - 1);
  const routeEase = easeInOutCubic(Math.min(1.0, progress / 0.82));
  const totalPos = routeEase * numSegs;

  // Build progressive curved Bezier path
  const routePath = $.NSBezierPath.bezierPath;
  routePath.lineCapStyle = $.NSLineCapStyleRound;
  routePath.moveToPoint($.NSMakePoint(pts[0].x, pts[0].y));
  let headPt = { x: pts[0].x, y: pts[0].y };

  for (let i = 0; i < numSegs; i++) {
    const segT = Math.min(1.0, Math.max(0.0, totalPos - i));
    if (segT <= 0.0) break;
    const p0 = pts[i];
    const p1 = pts[i + 1];
    const dx = p1.x - p0.x;
    const dy = p1.y - p0.y;
    const sign = i % 2 === 0 ? 1.0 : -1.0;
    const ctrl = {
      x: (p0.x + p1.x) * 0.5 - dy * 0.18 * sign,
      y: (p0.y + p1.y) * 0.5 + dx * 0.18 * sign,
    };
    const steps = 36;
    const maxStep = Math.max(1, Math.round(steps * segT));
    for (let s = 1; s <= maxStep; s++) {
      const t = (s / maxStep) * segT;
      headPt = quadBezierPoint(p0, ctrl, p1, t);
      routePath.lineToPoint($.NSMakePoint(headPt.x, headPt.y));
    }
  }

  // Soft golden glow halo under crisp #E8C58E line
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.26).setStroke;
  routePath.lineWidth = 10.0;
  routePath.stroke;

  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.96).setStroke;
  routePath.lineWidth = 3.5;
  routePath.stroke;

  // Glowing animated travel marker dot
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.35).setFill;
  $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(headPt.x - 13, headPt.y - 13, 26, 26)).fill;
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(1.0, 0.95, 0.85, 1.0).setFill;
  $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(headPt.x - 6, headPt.y - 6, 12, 12)).fill;

  // Crisp pin badges fading in as route reaches each stop
  for (let i = 0; i < pts.length; i++) {
    const reach = Math.min(1.0, Math.max(0.0, (totalPos - (i - 0.15)) / 0.25));
    const pinAlpha = i === 0 ? Math.min(1.0, progress / 0.15) : easeOutCubic(reach);
    if (pinAlpha <= 0.02) continue;

    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, pinAlpha).setFill;
    $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(pts[i].x - 7, pts[i].y - 7, 14, 14)).fill;

    const lblAttrs = makeTextAttrs(
      $.NSFont.systemFontOfSizeWeight(24, $.NSFontWeightBold),
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.98, 0.97, 0.95, pinAlpha),
      shadow
    );
    const subAttrs = makeTextAttrs(
      $.NSFont.systemFontOfSizeWeight(16, $.NSFontWeightMedium),
      $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, pinAlpha * 0.95),
      null
    );

    const lblText = pts[i].label;
    const subText = pts[i].subtitle;
    const lblSize = $(lblText).sizeWithAttributes(lblAttrs);
    const subSize = subText ? $(subText).sizeWithAttributes(subAttrs) : { width: 0, height: 0 };
    const pillW = Math.max(lblSize.width, subSize.width) + 32;
    const pillH = subText ? 64 : 42;
    const pillX = pts[i].x + 20;
    const pillY = pts[i].y - pillH * 0.5;

    const pill = $.NSBezierPath.bezierPathWithRoundedRectXRadiusYRadius(
      $.NSMakeRect(pillX, pillY, pillW, pillH),
      10,
      10
    );
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.07, 0.075, 0.095, 0.86 * pinAlpha).setFill;
    pill.fill;
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.910, 0.773, 0.557, 0.45 * pinAlpha).setStroke;
    pill.lineWidth = 1.2;
    pill.stroke;

    $(lblText).drawAtPointWithAttributes(
      $.NSMakePoint(pillX + 16, pillY + (subText ? 30 : 9)),
      lblAttrs
    );
    if (subText) {
      $(subText).drawAtPointWithAttributes($.NSMakePoint(pillX + 16, pillY + 9), subAttrs);
    }
  }
}

function renderGraphicCardCI(shot, progress, width, height, backdropImg, lookId) {
  const gType = shot.graphic_type || "chapter_title";
  const hasBackdrop = Boolean(backdropImg);

  const canvas = $.NSImage.alloc.initWithSize($.NSMakeSize(width, height));
  canvas.lockFocus;
  drawCardScrim(width, height, hasBackdrop);

  if (gType === "route_map" && Array.isArray(shot.waypoints) && shot.waypoints.length > 0) {
    drawRouteMapOverlay(shot, progress, width, height);
  } else {
    drawEditorialCardOverlay(shot, progress, width, height);
  }

  canvas.unlockFocus;
  const rep = $.NSBitmapImageRep.imageRepWithData(canvas.TIFFRepresentation);
  let overlayCI = $.CIImage.imageWithCGImage(rep.CGImage);
  const oExt = overlayCI.extent;
  if (oExt.size.width !== width || oExt.size.height !== height) {
    overlayCI = overlayCI.imageByApplyingTransform(
      $.CGAffineTransformMakeScale(width / oExt.size.width, height / oExt.size.height)
    );
  }

  if (!hasBackdrop) return overlayCI;
  const blurRadius = gType === "route_map" ? 26.0 : 16.0;
  const bgCI = buildCardBackdropCI(backdropImg, progress, blurRadius, lookId || "warm_film", width, height);
  return overlayCI.imageByCompositingOverImage(bgCI);
}

function renderCIImageToPixelBuffer(ciCtx, ciImg, pb, width, height, colorSpace) {
  const rect = $.CGRectMake(0, 0, width, height);
  $.CVPixelBufferLockBaseAddress(pb, 0);
  const base = $.CVPixelBufferGetBaseAddress(pb);
  const bpr = $.CVPixelBufferGetBytesPerRow(pb);
  const cgCtx = $.CGBitmapContextCreate(
    base,
    width,
    height,
    8,
    bpr,
    colorSpace,
    8194 // kCGImageAlphaPremultipliedFirst (2) | kCGBitmapByteOrder32Little (2 << 12)
  );
  if (cgCtx) {
    if (ciCtx && typeof ciCtx.createCGImageFromRect === "function") {
      const cgImg = ciCtx.createCGImageFromRect(ciImg, rect);
      if (cgImg) $.CGContextDrawImage(cgCtx, rect, cgImg);
    } else {
      const rep = $.NSCIImageRep.imageRepWithCIImage(ciImg);
      const nsGfx = $.NSGraphicsContext.graphicsContextWithCGContextFlipped(cgCtx, false);
      $.NSGraphicsContext.saveGraphicsState;
      $.NSGraphicsContext.setCurrentContext(nsGfx);
      rep.drawInRect($.NSMakeRect(0, 0, width, height));
      $.NSGraphicsContext.restoreGraphicsState;
    }
  }
  $.CVPixelBufferUnlockBaseAddress(pb, 0);
}

function allocPixelBuffer(width, height) {
  const pbRef = Ref();
  const attrs = $.NSMutableDictionary.dictionary;
  attrs.setObjectForKey($.NSNumber.numberWithBool(true), "CGImageCompatibility");
  attrs.setObjectForKey($.NSNumber.numberWithBool(true), "CGBitmapContextCompatibility");
  $.CVPixelBufferCreate($.kCFAllocatorDefault, width, height, 1111970369, attrs, pbRef);
  if (!pbRef[0]) throw new Error("Failed to allocate CVPixelBuffer");
  return pbRef[0];
}

function microYield(frameIdx) {
  if (frameIdx % 2 === 0) {
    $.NSThread.sleepForTimeInterval(0.008);
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.001));
  }
}

function appendVideoFrames(shotsSlice, totalEdlCount, startOffset, lookId, adaptor, videoInput, ciCtx, width, height, fps, logPath) {
  const colorSpace = $.CGColorSpaceCreateDeviceRGB();
  let globalFrame = 0;

  for (let i = 0; i < shotsSlice.length; i++) {
    const sIdx = startOffset + i;
    const shot = shotsSlice[i];
    const inSec = Number(shot.in_sec || 0);
    const outSec = Number(shot.out_sec || 3);
    const durSec = Math.max(0.2, outSec - inSec);
    const numFrames = Math.max(1, Math.round(durSec * fps));
    const mtype = shot.media_type || "photo";
    const fadeIn = shot.fade_in !== undefined ? Number(shot.fade_in) : (mtype === "graphic" || sIdx === 0 ? 0.35 : 0.0);
    const fadeOut = shot.fade_out !== undefined ? Number(shot.fade_out) : (mtype === "graphic" || sIdx === totalEdlCount - 1 ? 0.35 : 0.0);

    logProgress(logPath, "[shot " + (i + 1) + "/" + shotsSlice.length + " (global " + (sIdx + 1) + "/" + totalEdlCount + ")] " + (shot.shot_id || mtype) + " (" + numFrames + "f)");

    if (mtype === "graphic") {
      const backdropImg = shot.backdrop_path ? loadOrientedCIImage(ciCtx, shot.backdrop_path, 2400) : null;
      for (let f = 0; f < numFrames; f++) {
        while (!videoInput.readyForMoreMediaData) $.NSThread.sleepForTimeInterval(0.005);
        const prog = numFrames > 1 ? f / (numFrames - 1) : 1.0;
        let ciFrame = renderGraphicCardCI(shot, prog, width, height, backdropImg, lookId);
        ciFrame = applyFadeOverlay(ciFrame, f, numFrames, fps, fadeIn, fadeOut, width, height);
        const pb = allocPixelBuffer(width, height);
        renderCIImageToPixelBuffer(ciCtx, ciFrame, pb, width, height, colorSpace);
        adaptor.appendPixelBufferWithPresentationTime(pb, $.CMTimeMake(globalFrame++, fps));
        microYield(f);
      }
      continue;
    }

    if (mtype === "photo") {
      const imgA = loadOrientedCIImage(ciCtx, shot.source_path, 2400);
      const imgB = shot.pair_source_path ? loadOrientedCIImage(ciCtx, shot.pair_source_path, 2400) : null;
      const isPortrait = shot.orientation === "portrait";
      for (let f = 0; f < numFrames; f++) {
        while (!videoInput.readyForMoreMediaData) $.NSThread.sleepForTimeInterval(0.005);
        const prog = numFrames > 1 ? f / (numFrames - 1) : 0.0;
        let ciFrame = isPortrait
          ? renderPortraitComposite(imgA, imgB, shot.aspect_handling || "blurred_bg_pillarbox", prog, width, height)
          : renderKenBurnsFrame(imgA, prog, shot.focal_anchor, shot.ken_burns_dir || "in", width, height);
        ciFrame = applyLookFilter(ciFrame, lookId);
        ciFrame = applyFadeOverlay(ciFrame, f, numFrames, fps, fadeIn, fadeOut, width, height);
        const pb = allocPixelBuffer(width, height);
        renderCIImageToPixelBuffer(ciCtx, ciFrame, pb, width, height, colorSpace);
        adaptor.appendPixelBufferWithPresentationTime(pb, $.CMTimeMake(globalFrame++, fps));
        microYield(f);
      }
      continue;
    }

    const AVURLAsset = avClass("AVURLAsset");
    const AVAssetReader = avClass("AVAssetReader");
    const AVAssetReaderTrackOutput = avClass("AVAssetReaderTrackOutput");
    const asset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(shot.source_path), $({}));
    const vTracks = asset.tracksWithMediaType($.AVMediaTypeVideo);
    if (!vTracks || vTracks.count === 0) continue;
    const vTrack = vTracks.objectAtIndex(0);
    const reader = AVAssetReader.assetReaderWithAssetError(asset, null);
    reader.timeRange = $.CMTimeRangeMake($.CMTimeMakeWithSeconds(inSec, 600), $.CMTimeMakeWithSeconds(durSec, 600));
    const outOpts = $.NSMutableDictionary.dictionary;
    outOpts.setObjectForKey($.NSNumber.numberWithUnsignedInt(1111970369), "PixelFormatType");
    const output = AVAssetReaderTrackOutput.assetReaderTrackOutputWithTrackOutputSettings(vTrack, outOpts);
    reader.addOutput(output);
    reader.startReading;

    // Map Y-down AVAssetTrack.preferredTransform to Quartz Y-up CGImagePropertyOrientation
    const prefTransform = vTrack.preferredTransform;
    const ta = Math.round(prefTransform.a);
    const tb = Math.round(prefTransform.b);
    const tc = Math.round(prefTransform.c);
    const td = Math.round(prefTransform.d);
    let cgOrient = 1;
    if (ta === 0 && tb === 1 && tc === -1 && td === 0) cgOrient = 6;       // 90° CW portrait (standard iPhone)
    else if (ta === 0 && tb === -1 && tc === 1 && td === 0) cgOrient = 8; // 90° CCW portrait
    else if (ta === -1 && tb === 0 && tc === 0 && td === -1) cgOrient = 3; // 180° inverted

    let lastImg = null;
    let nextSample = output.copyNextSampleBuffer;
    let nextPts = nextSample ? $.CMTimeGetSeconds($.CMSampleBufferGetPresentationTimeStamp(nextSample)) : Infinity;

    for (let f = 0; f < numFrames; f++) {
      const targetPts = inSec + f / fps;
      while (nextSample && nextPts <= targetPts + 0.001) {
        const imgBuf = $.CMSampleBufferGetImageBuffer(nextSample);
        if (imgBuf) {
          let ci = $.CIImage.imageWithCVImageBuffer(imgBuf);
          if (cgOrient !== 1) ci = ci.imageByApplyingCGOrientation(cgOrient);
          lastImg = normalizeOrigin(ci);
        }
        nextSample = output.copyNextSampleBuffer;
        nextPts = nextSample ? $.CMTimeGetSeconds($.CMSampleBufferGetPresentationTimeStamp(nextSample)) : Infinity;
      }
      if (!lastImg) continue;
      while (!videoInput.readyForMoreMediaData) $.NSThread.sleepForTimeInterval(0.005);
      const prog = numFrames > 1 ? f / (numFrames - 1) : 0.0;
      let ciFrame = shot.orientation === "portrait"
        ? renderPortraitComposite(lastImg, null, "blurred_bg_pillarbox", prog, width, height)
        : aspectFillAndCrop(lastImg, width, height);
      ciFrame = applyLookFilter(ciFrame, lookId);
      ciFrame = applyFadeOverlay(ciFrame, f, numFrames, fps, fadeIn, fadeOut, width, height);
      const pb = allocPixelBuffer(width, height);
      renderCIImageToPixelBuffer(ciCtx, ciFrame, pb, width, height, colorSpace);
      adaptor.appendPixelBufferWithPresentationTime(pb, $.CMTimeMake(globalFrame++, fps));
      microYield(f);
    }
    reader.cancelReading;
  }
  return globalFrame / fps;
}

function renderVideoOnly(shotsSlice, totalEdlCount, startOffset, lookId, outPath, width, height, fps, logPath) {
  ensureParentDir(outPath);
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(outPath)) fm.removeItemAtPathError(outPath, null);

  const AVAssetWriter = avClass("AVAssetWriter");
  const AVAssetWriterInput = avClass("AVAssetWriterInput");
  const AVAssetWriterInputPixelBufferAdaptor = avClass("AVAssetWriterInputPixelBufferAdaptor");

  const writer = AVAssetWriter.assetWriterWithURLFileTypeError($.NSURL.fileURLWithPath(outPath), $.AVFileTypeMPEG4, null);
  const compProps = $.NSMutableDictionary.dictionary;
  compProps.setObjectForKey($.NSNumber.numberWithInt(12000000), $.AVVideoAverageBitRateKey);

  const videoSettings = $.NSMutableDictionary.dictionary;
  videoSettings.setObjectForKey($.AVVideoCodecTypeH264, $.AVVideoCodecKey);
  videoSettings.setObjectForKey($.NSNumber.numberWithInt(width), $.AVVideoWidthKey);
  videoSettings.setObjectForKey($.NSNumber.numberWithInt(height), $.AVVideoHeightKey);
  videoSettings.setObjectForKey(compProps, $.AVVideoCompressionPropertiesKey);

  const videoInput = AVAssetWriterInput.assetWriterInputWithMediaTypeOutputSettings($.AVMediaTypeVideo, videoSettings);
  videoInput.expectsMediaDataInRealTime = false;

  const pbAttrs = $.NSMutableDictionary.dictionary;
  pbAttrs.setObjectForKey($.NSNumber.numberWithUnsignedInt(1111970369), "PixelFormatType");
  pbAttrs.setObjectForKey($.NSNumber.numberWithInt(width), "Width");
  pbAttrs.setObjectForKey($.NSNumber.numberWithInt(height), "Height");
  const adaptor = AVAssetWriterInputPixelBufferAdaptor.assetWriterInputPixelBufferAdaptorWithAssetWriterInputSourcePixelBufferAttributes(
    videoInput,
    pbAttrs
  );

  writer.addInput(videoInput);
  writer.startWriting;
  writer.startSessionAtSourceTime($.kCMTimeZero);

  const ciCtx = $.CIContext.contextWithOptions($({}));
  const renderedDur = appendVideoFrames(shotsSlice, totalEdlCount, startOffset, lookId, adaptor, videoInput, ciCtx, width, height, fps, logPath);
  videoInput.markAsFinished;

  logProgress(logPath, "Finishing AVAssetWriter (" + renderedDur.toFixed(2) + "s) -> " + outPath);
  writer.finishWritingWithCompletionHandler(function() {});
  while (Number(writer.status) === 1) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }

  if (Number(writer.status) !== 2) {
    const errMsg = writer.error ? ObjC.unwrap(writer.error.localizedDescription) : ("status=" + Number(writer.status));
    throw new Error("Video-only AVAssetWriter failed: " + errMsg);
  }
  return renderedDur;
}

function muxSegmentsAndAudio(edl, segmentPaths, finalOutputPath, logPath) {
  ensureParentDir(finalOutputPath);
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(finalOutputPath)) fm.removeItemAtPathError(finalOutputPath, null);

  const AVMutableComposition = avClass("AVMutableComposition");
  const AVURLAsset = avClass("AVURLAsset");
  const AVMutableAudioMixInputParameters = avClass("AVMutableAudioMixInputParameters");
  const AVMutableAudioMix = avClass("AVMutableAudioMix");
  const AVAssetExportSession = avClass("AVAssetExportSession");

  const comp = AVMutableComposition.composition;
  const vCompTrack = comp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeVideo, 0);

  let videoCursor = $.kCMTimeZero;
  for (const segPath of segmentPaths) {
    const segAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(segPath), $({}));
    const vTracks = segAsset.tracksWithMediaType($.AVMediaTypeVideo);
    if (!vTracks || vTracks.count === 0) throw new Error("Segment has no video track: " + segPath);
    const range = $.CMTimeRangeMake($.kCMTimeZero, segAsset.duration);
    vCompTrack.insertTimeRangeOfTrackAtTimeError(range, vTracks.objectAtIndex(0), videoCursor, null);
    videoCursor = $.CMTimeAdd(videoCursor, segAsset.duration);
  }
  const totalDurSec = $.CMTimeGetSeconds(videoCursor);

  const mixParams = $.NSMutableArray.array;
  let cursorSec = 0.0;
  for (const shot of edl.shots) {
    const inSec = Number(shot.in_sec || 0);
    const outSec = Number(shot.out_sec || 3);
    const durSec = Math.max(0.2, outSec - inSec);
    if ((shot.media_type || "photo") === "video" && shot.source_path) {
      const asset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(shot.source_path), $({}));
      const aTracks = asset.tracksWithMediaType($.AVMediaTypeAudio);
      if (aTracks && aTracks.count > 0) {
        const compTrack = comp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
        const range = $.CMTimeRangeMake($.CMTimeMakeWithSeconds(inSec, 600), $.CMTimeMakeWithSeconds(durSec, 600));
        compTrack.insertTimeRangeOfTrackAtTimeError(range, aTracks.objectAtIndex(0), $.CMTimeMakeWithSeconds(cursorSec, 600), null);
        const p = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(compTrack);
        p.setVolumeAtTime(0.85, $.CMTimeMakeWithSeconds(cursorSec, 600));
        mixParams.addObject(p);
      }
    }
    cursorSec += durSec;
  }

  if (edl.bgm_path && fm.fileExistsAtPath(edl.bgm_path)) {
    const bgmAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(edl.bgm_path), $({}));
    const bgmTracks = bgmAsset.tracksWithMediaType($.AVMediaTypeAudio);
    if (bgmTracks && bgmTracks.count > 0) {
      const bgmSrc = bgmTracks.objectAtIndex(0);
      const bgmDur = $.CMTimeGetSeconds(bgmAsset.duration);
      const bgmCompTrack = comp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
      let filled = 0.0;
      while (filled < totalDurSec && bgmDur > 0.1) {
        const segDur = Math.min(bgmDur, totalDurSec - filled);
        const r = $.CMTimeRangeMake($.kCMTimeZero, $.CMTimeMakeWithSeconds(segDur, 600));
        bgmCompTrack.insertTimeRangeOfTrackAtTimeError(r, bgmSrc, $.CMTimeMakeWithSeconds(filled, 600), null);
        filled += segDur;
      }
      const p = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(bgmCompTrack);
      p.setVolumeAtTime(0.65, $.kCMTimeZero);
      if (totalDurSec > 2.0) {
        p.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
          0.65,
          0.0,
          $.CMTimeRangeMake($.CMTimeMakeWithSeconds(totalDurSec - 1.8, 600), $.CMTimeMakeWithSeconds(1.8, 600))
        );
      }
      mixParams.addObject(p);
    }
  }

  logProgress(logPath, "Exporting muxed master (" + totalDurSec.toFixed(2) + "s) -> " + finalOutputPath);
  const exporter = AVAssetExportSession.exportSessionWithAssetPresetName(comp, $.AVAssetExportPresetHighestQuality);
  exporter.outputURL = $.NSURL.fileURLWithPath(finalOutputPath);
  exporter.outputFileType = $.AVFileTypeMPEG4;
  exporter.shouldOptimizeForNetworkUse = true;
  if (mixParams.count > 0) {
    const audioMix = AVMutableAudioMix.audioMix;
    audioMix.inputParameters = mixParams;
    exporter.audioMix = audioMix;
  }

  exporter.exportAsynchronouslyWithCompletionHandler(function() {});
  while (Number(exporter.status) === 1 || Number(exporter.status) === 2) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }

  if (Number(exporter.status) !== 3) {
    const errDesc = exporter.error ? ObjC.unwrap(exporter.error.localizedDescription) : ("status=" + Number(exporter.status));
    throw new Error("AVAssetExportSession failed: " + errDesc);
  }
  return totalDurSec;
}

function run(argv) {
  const args = parseArgs(argv);
  if (args.help) {
    return JSON.stringify({
      usage: "osascript -l JavaScript macos_render_trip.jxa --edl ./work/edl.json --output <out.mp4> [--start-shot 0 --end-shot 10 --video-only] [--mux-segments s1.mp4,s2.mp4] [--width 1920] [--height 1080] [--fps 30] [--dry-run]",
    }, null, 2);
  }
  if (!args.edl) throw new Error("Missing --edl <edl.json>.");

  const edl = readJsonFile(args.edl);
  const allShots = edl.shots || [];
  if (allShots.length === 0) throw new Error("EDL has no shots.");

  const startIdx = args.startShot !== null ? Math.max(0, args.startShot) : 0;
  const endIdx = args.endShot !== null ? Math.min(allShots.length, args.endShot) : allShots.length;
  const shotsSlice = allShots.slice(startIdx, endIdx);

  const estDuration = shotsSlice.reduce((acc, s) => acc + Math.max(0.2, Number(s.out_sec || 3) - Number(s.in_sec || 0)), 0);
  if (args.dryRun) {
    return JSON.stringify({
      status: "dry_run",
      renderer: "macos-native-avfoundation-jxa",
      output: args.output,
      mode: args.muxSegments ? "mux_segments" : (args.videoOnly ? "video_only_slice" : "full_render"),
      resolution: args.width + "x" + args.height,
      fps: args.fps,
      start_shot: startIdx,
      end_shot: endIdx,
      shot_count: shotsSlice.length,
      estimated_duration_sec: Number(estDuration.toFixed(2)),
      look_id: edl.look_id || "clean_natural",
    }, null, 2);
  }

  const logPath = args.output + ".progress.log";
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(logPath)) fm.removeItemAtPathError(logPath, null);

  if (args.muxSegments && args.muxSegments.length > 0) {
    const dur = muxSegmentsAndAudio(edl, args.muxSegments, args.output, logPath);
    return JSON.stringify({
      status: "muxed",
      renderer: "macos-native-avfoundation-jxa",
      output: args.output,
      segment_count: args.muxSegments.length,
      duration_sec: Number(dur.toFixed(2)),
    }, null, 2);
  }

  if (args.videoOnly) {
    const dur = renderVideoOnly(shotsSlice, allShots.length, startIdx, edl.look_id || "clean_natural", args.output, args.width, args.height, args.fps, logPath);
    return JSON.stringify({
      status: "rendered_video_only",
      renderer: "macos-native-avfoundation-jxa",
      output: args.output,
      start_shot: startIdx,
      end_shot: endIdx,
      shot_count: shotsSlice.length,
      duration_sec: Number(dur.toFixed(2)),
    }, null, 2);
  }

  const videoTmpPath = args.output + ".video_tmp.mp4";
  const renderedDur = renderVideoOnly(shotsSlice, allShots.length, startIdx, edl.look_id || "clean_natural", videoTmpPath, args.width, args.height, args.fps, logPath);
  muxSegmentsAndAudio(edl, [videoTmpPath], args.output, logPath);
  if (fm.fileExistsAtPath(videoTmpPath)) fm.removeItemAtPathError(videoTmpPath, null);

  return JSON.stringify({
    status: "rendered",
    renderer: "macos-native-avfoundation-jxa",
    output: args.output,
    duration_sec: Number(renderedDur.toFixed(2)),
    shot_count: shotsSlice.length,
  }, null, 2);
}
