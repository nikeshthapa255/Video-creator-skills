#!/usr/bin/env osascript -l JavaScript
/**
 * Trip Cinema Studio v0.2.0 — Modular Video-First macOS Native Renderer.
 * 100% Apple-signed AVFoundation + CoreImage + AppKit + CoreGraphics (zero third-party binaries).
 *
 * Key v0.2.0 upgrades:
 *   - Modular lib/{style_engine,layouts,transitions,cards}.js loaded cleanly relative to script path
 *   - Declarative Style Packs (styles/<style_id>.json) + 16:9 (1920x1080) & 9:16 (1080x1920) aspect profiles
 *   - Unified Hardware Rec.709 Video Decoder (AVAssetReaderVideoCompositionOutput with renderSize downscale,
 *     preferredTransform orientation, and HDR/HLG/Dolby Vision -> ITU_R_709_2 tone mapping + TrackOutput fallback)
 *   - Closed-form Piecewise Cubic Speed Ramping (forward-only 2-frame sliding reader + velocity CIMotionBlur)
 *   - Live Moving-Buffer Transition Lookahead (both Shot A tail and Shot B head advance live during overlap)
 *   - Multi-source concurrent video layouts (split_2up_video, triptych_3up_video, bento_living_grid, polaroid_stack)
 *   - 2-Step Lossless 4-Track Audio Mux (NAT_A/NAT_B J/L-cuts + BGM Sonic Postcard ducking + SFX -> AppleM4A -> Passthrough)
 *   - Batched rendering (--start-shot / --end-shot --video-only) + strict memory hygiene (CVPixelBufferRelease,
 *     CMSampleBufferInvalidate, kCIContextCacheIntermediates: false, alwaysCopiesSampleData: false)
 */

ObjC.import("Foundation");
ObjC.import("AVFoundation");
ObjC.import("CoreImage");
ObjC.import("CoreMedia");
ObjC.import("CoreVideo");
ObjC.import("CoreAudio");
ObjC.import("ImageIO");
ObjC.import("AppKit");
ObjC.import("CoreGraphics");

function avClass(name) {
  const cls = $.NSClassFromString(name);
  if (!cls) throw new Error("AVFoundation class not found: " + name);
  return cls;
}

function resolveScriptDir() {
  const fm = $.NSFileManager.defaultManager;
  const cwd = ObjC.unwrap(fm.currentDirectoryPath);
  const procArgs = $.NSProcessInfo.processInfo.arguments;
  for (let i = 0; i < Number(procArgs.count); i++) {
    const raw = ObjC.unwrap(procArgs.objectAtIndex(i));
    if (raw && raw.endsWith(".jxa")) {
      const absPath = raw.startsWith("/") ? raw : (cwd + "/" + raw);
      return ObjC.unwrap($(absPath).stringByStandardizingPath.stringByDeletingLastPathComponent);
    }
  }
  return cwd;
}

function loadNativeLibs(scriptDir) {
  const libDir = scriptDir + "/lib";
  const modules = ["style_engine.js", "layouts.js", "transitions.js", "cards.js"];
  for (let i = 0; i < modules.length; i++) {
    const p = libDir + "/" + modules[i];
    const nsStr = $.NSString.stringWithContentsOfFileEncodingError(p, $.NSUTF8StringEncoding, null);
    if (!nsStr) throw new Error("Failed to load native engine library: " + p);
    // Indirect eval attaches TripStyleEngine / TripLayouts / TripTransitions / TripCards on global scope
    (0, eval)(ObjC.unwrap(nsStr));
  }
  return {
    StyleEngine: this.TripStyleEngine,
    Layouts: this.TripLayouts,
    Transitions: this.TripTransitions,
    Cards: this.TripCards,
  };
}

function parseArgs(argv) {
  const args = {
    edl: null,
    output: "./output/trip_cinema.mp4",
    width: null,
    height: null,
    fps: null,
    styleId: null,
    stylesDir: null,
    startShot: null,
    endShot: null,
    videoOnly: false,
    muxSegments: null,
    dryRun: false,
    help: false,
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--help" || a === "-h") args.help = true;
    else if (a === "--edl") args.edl = argv[++i];
    else if (a === "--output" || a === "-o") args.output = argv[++i];
    else if (a === "--width") args.width = parseInt(argv[++i], 10) || null;
    else if (a === "--height") args.height = parseInt(argv[++i], 10) || null;
    else if (a === "--fps") args.fps = parseInt(argv[++i], 10) || null;
    else if (a === "--style-id") args.styleId = argv[++i];
    else if (a === "--styles-dir") args.stylesDir = argv[++i];
    else if (a === "--start-shot") args.startShot = parseInt(argv[++i], 10);
    else if (a === "--end-shot") args.endShot = parseInt(argv[++i], 10);
    else if (a === "--video-only") args.videoOnly = true;
    else if (a === "--mux-segments") args.muxSegments = argv[++i].split(",").map((s) => s.trim()).filter(Boolean);
    else if (a === "--dry-run") args.dryRun = true;
  }
  return args;
}

function readJsonFile(path) {
  const nsStr = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
  if (!nsStr) throw new Error("Failed to read JSON: " + path);
  return JSON.parse(ObjC.unwrap(nsStr));
}

function ensureParentDir(filePath) {
  const parent = $(filePath).stringByDeletingLastPathComponent;
  $.NSFileManager.defaultManager.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
    parent,
    true,
    $({}),
    null
  );
}

function logProgress(logPath, msg) {
  const line = "[" + new Date().toISOString() + "] " + msg + "\n";
  const data = $(line).dataUsingEncoding($.NSUTF8StringEncoding);
  $.NSFileHandle.fileHandleWithStandardError.writeData(data);
  if (logPath) {
    try {
      const fm = $.NSFileManager.defaultManager;
      if (fm.fileExistsAtPath(logPath)) {
        const fh = $.NSFileHandle.fileHandleForWritingAtPath(logPath);
        if (fh && typeof fh.seekToEndOfFile !== "undefined") {
          fh.seekToEndOfFile;
          fh.writeData(data);
          fh.closeFile;
          return;
        }
      }
      $(line).writeToFileAtomicallyEncodingError(logPath, true, $.NSUTF8StringEncoding, null);
    } catch (e) {
      // Never fail render on progress log write
    }
  }
}

function resolveCanvasDims(args, edl) {
  let w = 1920;
  let h = 1080;
  if (edl && edl.aspect_profile === "9:16") {
    w = 1080;
    h = 1920;
  } else if (edl && typeof edl.resolution === "string" && edl.resolution.indexOf("x") > 0) {
    const parts = edl.resolution.split("x");
    const pw = parseInt(parts[0], 10);
    const ph = parseInt(parts[1], 10);
    if (pw > 0 && ph > 0) {
      w = pw;
      h = ph;
    }
  }
  if (args.width) w = args.width;
  if (args.height) h = args.height;
  const fps = args.fps || (edl && Number(edl.fps)) || 30;
  return { width: w, height: h, fps: fps };
}

function normalizeOrigin(ciImg) {
  if (!ciImg) return ciImg;
  const ext = ciImg.extent;
  if (ext.origin.x !== 0 || ext.origin.y !== 0) {
    return ciImg.imageByApplyingTransform($.CGAffineTransformMakeTranslation(-ext.origin.x, -ext.origin.y));
  }
  return ciImg;
}

function loadOrientedCIImage(filePath, maxDim) {
  const limit = maxDim || 2400;
  const url = $.NSURL.fileURLWithPath(filePath);
  const opts = $.NSMutableDictionary.dictionary;
  opts.setObjectForKey($.NSNumber.numberWithBool(true), $.kCIImageApplyOrientationProperty);
  let img = $.CIImage.imageWithContentsOfURLOptions(url, opts);
  if (!img) throw new Error("Failed to load image: " + filePath);
  img = normalizeOrigin(img);

  const w = img.extent.size.width;
  const h = img.extent.size.height;
  const maxSide = Math.max(w, h);
  if (maxSide > limit) {
    const scale = limit / maxSide;
    const lanczos = $.CIFilter.filterWithName("CILanczosScaleTransform");
    if (lanczos) {
      lanczos.setValueForKey(img, "inputImage");
      lanczos.setValueForKey(scale, "inputScale");
      lanczos.setValueForKey(1.0, "inputAspectRatio");
      img = normalizeOrigin(lanczos.outputImage);
    } else {
      img = normalizeOrigin(img.imageByApplyingTransform($.CGAffineTransformMakeScale(scale, scale)));
    }
  }
  return img;
}

// =========================================================================
// CLOSED-FORM PIECEWISE CUBIC SPEED RAMPING
// =========================================================================
function buildSpeedModel(shot) {
  const sp = shot && shot.speed_profile ? shot.speed_profile : null;
  const inSec = Number((shot && shot.in_sec) || 0);
  const outSec = Number((shot && shot.out_sec) || (inSec + 3.0));
  const rawSpan = Math.max(0.2, outSec - inSec);

  if (!sp || !sp.mode || sp.mode === "constant") {
    const rate = sp && sp.rate !== undefined ? Math.max(0.15, Number(sp.rate)) : 1.0;
    const outDur = shot && shot.duration_sec > 0 ? Number(shot.duration_sec) : Math.max(0.2, rawSpan / rate);
    return {
      mode: "constant",
      inSec: inSec,
      outDur: outDur,
      sourceSpan: outDur * rate,
      peakSpeed: rate,
      evalAt: function (tOut) {
        const t = Math.max(0, tOut);
        return { sourceTime: inSec + t * rate, speed: rate };
      },
    };
  }

  // 5-phase cubic_ramp (or explicit segments[])
  let segs = [];
  if (Array.isArray(sp.segments) && sp.segments.length > 0) {
    segs = sp.segments.map((s) => ({
      dur: Math.max(0.0, Number(s.dur_sec || 0)),
      v0: Math.max(0.15, Number(s.v_start !== undefined ? s.v_start : 1.0)),
      v1: Math.max(0.15, Number(s.v_end !== undefined ? s.v_end : 1.0)),
    })).filter((s) => s.dur > 0.0001);
  } else {
    const vHi = Math.max(0.5, Number(sp.v_hi !== undefined ? sp.v_hi : 3.5));
    const vLo = Math.max(0.2, Number(sp.v_lo !== undefined ? sp.v_lo : 0.5));
    const d1 = Math.max(0.0, Number(sp.d1 !== undefined ? sp.d1 : 0.30));
    const d2 = Math.max(0.0, Number(sp.d2 !== undefined ? sp.d2 : 0.35));
    const d3 = Math.max(0.0, Number(sp.d3 !== undefined ? sp.d3 : 1.60));
    const d4 = Math.max(0.0, Number(sp.d4 !== undefined ? sp.d4 : 0.35));
    const d5 = Math.max(0.0, Number(sp.d5 !== undefined ? sp.d5 : 0.30));
    const phases = [
      { dur: d1, v0: vHi, v1: vHi },
      { dur: d2, v0: vHi, v1: vLo },
      { dur: d3, v0: vLo, v1: vLo },
      { dur: d4, v0: vLo, v1: vHi },
      { dur: d5, v0: vHi, v1: vHi },
    ];
    segs = phases.filter((s) => s.dur > 0.0001);
  }

  if (segs.length === 0) {
    return buildSpeedModel({ in_sec: inSec, out_sec: outSec, duration_sec: shot && shot.duration_sec });
  }

  // Pre-integrate cumulative output time and exact analytical source span S_req
  let tAcc = 0.0;
  let sAcc = 0.0;
  let peak = 1.0;
  const compiled = segs.map((seg) => {
    const dS = seg.dur * (seg.v0 + seg.v1) * 0.5;
    peak = Math.max(peak, seg.v0, seg.v1);
    const item = {
      t0: tAcc,
      t1: tAcc + seg.dur,
      dur: seg.dur,
      s0: sAcc,
      v0: seg.v0,
      v1: seg.v1,
    };
    tAcc += seg.dur;
    sAcc += dS;
    return item;
  });

  const outDur = shot && shot.duration_sec > 0 ? Number(shot.duration_sec) : Math.max(0.2, tAcc);
  const timeScale = tAcc > 0.001 ? tAcc / outDur : 1.0;

  return {
    mode: "cubic_ramp",
    inSec: inSec,
    outDur: outDur,
    sourceSpan: sAcc,
    peakSpeed: peak,
    evalAt: function (tOut) {
      const t = Math.max(0.0, Math.min(tAcc, tOut * timeScale));
      for (let i = 0; i < compiled.length; i++) {
        const seg = compiled[i];
        if (t <= seg.t1 || i === compiled.length - 1) {
          const u = Math.max(0.0, Math.min(1.0, (t - seg.t0) / Math.max(0.0001, seg.dur)));
          const dv = seg.v1 - seg.v0;
          const speed = seg.v0 + dv * (3.0 * u * u - 2.0 * u * u * u);
          const deltaS = seg.dur * (seg.v0 * u + dv * (u * u * u - 0.5 * u * u * u * u));
          return { sourceTime: inSec + seg.s0 + deltaS, speed: speed };
        }
      }
      return { sourceTime: inSec + sAcc, speed: 1.0 };
    },
  };
}

// =========================================================================
// UNIFIED HARDWARE REC.709 VIDEO DECODER (AVAssetReaderVideoCompositionOutput + Fallback)
// =========================================================================
function computeTransformBounds(natW, natH, t) {
  const corners = [
    { x: 0, y: 0 },
    { x: natW, y: 0 },
    { x: 0, y: natH },
    { x: natW, y: natH },
  ];
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  for (let i = 0; i < 4; i++) {
    const px = t.a * corners[i].x + t.c * corners[i].y + t.tx;
    const py = t.b * corners[i].x + t.d * corners[i].y + t.ty;
    if (px < minX) minX = px;
    if (px > maxX) maxX = px;
    if (py < minY) minY = py;
    if (py > maxY) maxY = py;
  }
  return {
    minX: minX,
    minY: minY,
    dispW: Math.max(2, maxX - minX),
    dispH: Math.max(2, maxY - minY),
  };
}

function mapPreferredTransformToCGOrientation(t) {
  const ta = Math.round(t.a);
  const tb = Math.round(t.b);
  const tc = Math.round(t.c);
  const td = Math.round(t.d);
  if (ta === 0 && tb === 1 && tc === -1 && td === 0) return 6;  // 90° CW portrait (standard iPhone)
  if (ta === 0 && tb === -1 && tc === 1 && td === 0) return 8;  // 90° CCW portrait
  if (ta === -1 && tb === 0 && tc === 0 && td === -1) return 3; // 180° inverted
  return 1;
}

function safeInvalidateSample(sb) {
  if (!sb) return;
  try {
    $.CMSampleBufferInvalidate(sb);
  } catch (e) {
    // Ignore if already invalidated
  }
}

function createVideoStream(sourcePath, opts) {
  const AVURLAsset = avClass("AVURLAsset");
  const AVAssetReader = avClass("AVAssetReader");
  const CompOut = avClass("AVAssetReaderVideoCompositionOutput");
  const MComp = avClass("AVMutableVideoComposition");
  const MInst = avClass("AVMutableVideoCompositionInstruction");
  const MLayer = avClass("AVMutableVideoCompositionLayerInstruction");
  const TrackOut = avClass("AVAssetReaderTrackOutput");

  const asset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(sourcePath), $({}));
  const vTracks = asset.tracksWithMediaType($.AVMediaTypeVideo);
  if (!vTracks || Number(vTracks.count) === 0) {
    throw new Error("Video asset has no video track: " + sourcePath);
  }
  const vTrack = vTracks.objectAtIndex(0);
  const assetDur = Math.max(0.1, $.CMTimeGetSeconds(asset.duration));
  const startSec = Math.max(0.0, Math.min(assetDur - 0.05, Number(opts.startSec || 0.0)));
  const spanSec = Math.max(0.1, Math.min(assetDur - startSec, Number(opts.spanSec || assetDur) + 0.5));
  const timeRange = $.CMTimeRangeMake($.CMTimeMakeWithSeconds(startSec, 600), $.CMTimeMakeWithSeconds(spanSec, 600));

  const natSize = vTrack.naturalSize;
  const natW = Math.max(2, Number(natSize.width) || 1920);
  const natH = Math.max(2, Number(natSize.height) || 1080);
  let prefT = vTrack.preferredTransform;
  const prefDet = Math.abs((Number(prefT.a) * Number(prefT.d)) - (Number(prefT.b) * Number(prefT.c)));
  if (!isFinite(prefDet) || prefDet < 1e-4) {
    prefT = { a: 1, b: 0, c: 0, d: 1, tx: 0, ty: 0 };
  }
  const bounds = computeTransformBounds(natW, natH, prefT);
  const srcFps = Math.max(24, Math.min(240, Number(vTrack.nominalFrameRate) || 30));

  const targetW = Math.max(64, Number(opts.targetW) || 1920);
  const targetH = Math.max(64, Number(opts.targetH) || 1080);
  const fitMode = opts.fitMode || "fill";
  let scale = fitMode === "fit"
    ? Math.min(1.0, Math.min(targetW / bounds.dispW, targetH / bounds.dispH))
    : Math.min(1.0, Math.max(targetW / bounds.dispW, targetH / bounds.dispH));
  // Cap decoded max side to 2160px to keep RAM & GPU bandwidth strictly bounded
  const maxDecodedSide = Math.max(bounds.dispW, bounds.dispH) * scale;
  if (maxDecodedSide > 2160) {
    scale *= 2160 / maxDecodedSide;
  }
  const outW = Math.max(2, Math.round((bounds.dispW * scale) / 2) * 2);
  const outH = Math.max(2, Math.round((bounds.dispH * scale) / 2) * 2);

  let reader = null;
  let output = null;
  let useTrackFallback = false;
  let cgOrient = 1;

  // Primary: AVAssetReaderVideoCompositionOutput (Hardware 4K->targetBox downscale + portrait upright + HDR->Rec.709!)
  try {
    reader = AVAssetReader.assetReaderWithAssetError(asset, null);
    if (!reader) throw new Error("AVAssetReader init returned nil");
    reader.timeRange = timeRange;

    const vComp = MComp.videoComposition;
    vComp.renderSize = $.CGSizeMake(outW, outH);
    vComp.frameDuration = $.CMTimeMake(100, Math.round(srcFps * 100));
    vComp.colorPrimaries = "ITU_R_709_2";
    vComp.colorTransferFunction = "ITU_R_709_2";
    vComp.colorYCbCrMatrix = "ITU_R_709_2";

    const inst = MInst.videoCompositionInstruction;
    inst.timeRange = $.CMTimeRangeMake($.kCMTimeZero, asset.duration);
    const layerInst = MLayer.videoCompositionLayerInstructionWithAssetTrack(vTrack);
    const sx = outW / bounds.dispW;
    const sy = outH / bounds.dispH;
    const M = $.CGAffineTransformMake(
      prefT.a * sx,
      prefT.b * sy,
      prefT.c * sx,
      prefT.d * sy,
      (prefT.tx - bounds.minX) * sx,
      (prefT.ty - bounds.minY) * sy
    );
    layerInst.setTransformAtTime(M, $.kCMTimeZero);
    inst.layerInstructions = $([layerInst]);
    vComp.instructions = $([inst]);

    const outOpts = $.NSMutableDictionary.dictionary;
    outOpts.setObjectForKey($.NSNumber.numberWithUnsignedInt(1111970369), "PixelFormatType");
    output = CompOut.assetReaderVideoCompositionOutputWithVideoTracksVideoSettings($([vTrack]), outOpts);
    output.videoComposition = vComp;
    output.alwaysCopiesSampleData = false;
    reader.addOutput(output);
    if (!reader.startReading) {
      throw new Error("VideoCompositionOutput startReading returned false");
    }
  } catch (e) {
    // Fallback: AVAssetReaderTrackOutput with verified CGImagePropertyOrientation upright fix
    if (reader) {
      try { reader.cancelReading; } catch (_) {}
    }
    useTrackFallback = true;
    cgOrient = mapPreferredTransformToCGOrientation(prefT);
    reader = AVAssetReader.assetReaderWithAssetError(asset, null);
    reader.timeRange = timeRange;
    const outOpts = $.NSMutableDictionary.dictionary;
    outOpts.setObjectForKey($.NSNumber.numberWithUnsignedInt(1111970369), "PixelFormatType");
    output = TrackOut.assetReaderTrackOutputWithTrackOutputSettings(vTrack, outOpts);
    output.alwaysCopiesSampleData = false;
    reader.addOutput(output);
    reader.startReading;
  }

  // Forward-only 2-frame sliding window [prev, curr]
  let prev = null;
  let curr = null;
  let eof = false;

  function pullNext() {
    if (eof) return null;
    const sb = output.copyNextSampleBuffer;
    if (!sb) {
      eof = true;
      return null;
    }
    const pts = $.CMTimeGetSeconds($.CMSampleBufferGetPresentationTimeStamp(sb));
    if (!isFinite(pts)) {
      eof = true;
      return null;
    }
    const imgBuf = $.CMSampleBufferGetImageBuffer(sb);
    if (!imgBuf) {
      safeInvalidateSample(sb);
      return pullNext();
    }
    let ci = $.CIImage.imageWithCVImageBuffer(imgBuf);
    if (useTrackFallback && cgOrient !== 1) {
      ci = ci.imageByApplyingCGOrientation(cgOrient);
    }
    ci = normalizeOrigin(ci);
    return { sb: sb, ci: ci, pts: pts };
  }

  // Prime first frame
  curr = pullNext();

  return {
    sourcePath: sourcePath,
    decoderMode: useTrackFallback ? "track_output_fallback" : "video_composition_rec709",
    decodedSize: outW + "x" + outH,
    assetDuration: assetDur,
    srcFps: srcFps,
    frameAt: function (targetPtsSec) {
      while (!eof && curr && curr.pts < targetPtsSec - 0.002) {
        const next = pullNext();
        if (!next) break;
        if (prev && prev.sb) safeInvalidateSample(prev.sb);
        prev = curr;
        curr = next;
      }
      if (prev && curr) {
        return Math.abs(prev.pts - targetPtsSec) < Math.abs(curr.pts - targetPtsSec) ? prev.ci : curr.ci;
      }
      return curr ? curr.ci : (prev ? prev.ci : null);
    },
    close: function () {
      if (prev && prev.sb) safeInvalidateSample(prev.sb);
      if (curr && curr.sb) safeInvalidateSample(curr.sb);
      prev = null;
      curr = null;
      try { reader.cancelReading; } catch (e) {}
    },
  };
}

// =========================================================================
// TIMELINE CALCULATION (Shared between Video Render & Audio Mux — ZERO A/V DRIFT)
// =========================================================================
function resolveShotTransition(shot, style, Transitions) {
  let raw = shot.transition_out;
  let explicitDur = shot.transition_duration_sec;
  if (raw && typeof raw === "object") {
    if (raw.duration_sec !== undefined) explicitDur = raw.duration_sec;
    raw = raw.type;
  }
  if (!raw && shot.transition) {
    raw = shot.transition;
  }
  const tType = Transitions.normalizeTransitionType(raw || "cut");
  const defaultDur = Number((style && style.transitions && style.transitions.default_duration_sec) || 0.45);
  const durSec = tType === "cut" ? 0.0 : Math.max(0.10, Math.min(1.5, Number(explicitDur || defaultDur)));
  return {
    type: tType,
    durationSec: durSec,
    focal_anchor: shot.focal_anchor,
  };
}

function computeTimeline(shots, style, fps, Transitions) {
  const entries = [];
  for (let i = 0; i < shots.length; i++) {
    const s = shots[i];
    const sm = buildSpeedModel(s);
    const numFrames = Math.max(1, Math.round(sm.outDur * fps));
    const trans = resolveShotTransition(s, style, Transitions);
    entries.push({
      shot: s,
      speedModel: sm,
      durSec: numFrames / fps,
      numFrames: numFrames,
      transOut: trans,
      overlapOutFrames: 0,
      overlapInFrames: 0,
      startFrame: 0,
      startSec: 0,
      endSec: 0,
    });
  }

  let cursorFrames = 0;
  for (let i = 0; i < entries.length; i++) {
    const cur = entries[i];
    cur.startFrame = cursorFrames;
    cur.startSec = cursorFrames / fps;
    cur.endSec = (cursorFrames + cur.numFrames) / fps;

    if (i < entries.length - 1 && cur.transOut.type !== "cut") {
      const next = entries[i + 1];
      const maxAllowSec = Math.min(cur.durSec * 0.45, next.durSec * 0.45);
      const ovSec = Math.min(cur.transOut.durationSec, maxAllowSec);
      const ovFrames = Math.max(2, Math.round(ovSec * fps));
      if (ovFrames < cur.numFrames && ovFrames < next.numFrames) {
        cur.overlapOutFrames = ovFrames;
        next.overlapInFrames = ovFrames;
      }
    }
    cursorFrames += cur.numFrames - cur.overlapOutFrames;
  }

  return {
    entries: entries,
    totalFrames: cursorFrames,
    totalDurSec: cursorFrames / fps,
  };
}

// =========================================================================
// SHOT PRODUCER (Unified Single/Multi-Source Photos, Videos, Speed Ramps, Graphics)
// =========================================================================
function resolveEffectiveLayout(shot, style, width, height) {
  const explicit = shot.layout || shot.aspect_handling;
  if (explicit) return String(explicit).toLowerCase().trim();
  const hasTiles = Array.isArray(shot.tiles) && shot.tiles.length >= 2;
  if (hasTiles) {
    if (shot.tiles.length >= 3) return "triptych_3up_video";
    return "split_2up_video";
  }
  if (shot.pair_source_path) return "split_diptych_pair";
  const isPortraitMedia = shot.orientation === "portrait";
  const isLandscapeCanvas = width > height;
  if (isPortraitMedia && isLandscapeCanvas) {
    return (style && style.layouts && style.layouts.default_portrait_layout) || "blurred_bg_pillarbox";
  }
  return "single";
}

function createShotProducer(entry, style, libs, width, height, fps) {
  const shot = entry.shot;
  const mtype = shot.media_type || "photo";
  const numFrames = entry.numFrames;
  const fm = $.NSFileManager.defaultManager;

  // Graphic card producer
  if (mtype === "graphic") {
    const backdropImg = (shot.backdrop_path && fm.fileExistsAtPath(shot.backdrop_path))
      ? loadOrientedCIImage(shot.backdrop_path, 2400)
      : null;
    const heroImg = (shot.source_path && fm.fileExistsAtPath(shot.source_path))
      ? loadOrientedCIImage(shot.source_path, 2400)
      : backdropImg;
    const maskImg = (shot.mask_path && fm.fileExistsAtPath(shot.mask_path))
      ? loadOrientedCIImage(shot.mask_path, 2400)
      : null;
    const assets = { backdropImg: backdropImg, heroImg: heroImg, maskImg: maskImg };

    return {
      renderFrame: function (localFrameIdx) {
        const prog = numFrames > 1 ? localFrameIdx / (numFrames - 1) : 1.0;
        return libs.Cards.renderCardFrame(shot, prog, width, height, assets, style);
      },
      close: function () {},
    };
  }

  // Build normalized list of source descriptors (supports tiles[], pair_source_path, extra_source_paths[], or single source_path)
  const layoutName = resolveEffectiveLayout(shot, style, width, height);
  const rawSources = [];
  if (Array.isArray(shot.tiles) && shot.tiles.length > 0) {
    for (let i = 0; i < shot.tiles.length; i++) {
      const t = shot.tiles[i];
      rawSources.push({
        sourcePath: t.source_path,
        mediaType: t.media_type || mtype,
        inSec: Number(t.in_sec !== undefined ? t.in_sec : (shot.in_sec || 0)),
        outSec: Number(t.out_sec !== undefined ? t.out_sec : (shot.out_sec || (entry.durSec + Number(t.in_sec || 0)))),
        anchor: t.focal_anchor || shot.focal_anchor,
        caption: t.caption || "",
        dateLabel: t.date_label || "",
      });
    }
  } else {
    rawSources.push({
      sourcePath: shot.source_path,
      mediaType: mtype,
      inSec: Number(shot.in_sec || 0),
      outSec: Number(shot.out_sec || (Number(shot.in_sec || 0) + entry.durSec)),
      anchor: shot.focal_anchor,
      caption: shot.caption || "",
      dateLabel: shot.date_stamp || shot.date_label || "",
    });
    if (shot.pair_source_path) {
      rawSources.push({
        sourcePath: shot.pair_source_path,
        mediaType: mtype,
        inSec: Number(shot.in_sec || 0),
        outSec: Number(shot.out_sec || (Number(shot.in_sec || 0) + entry.durSec)),
        anchor: shot.focal_anchor,
        caption: "",
        dateLabel: "",
      });
    }
    if (Array.isArray(shot.extra_source_paths)) {
      for (let i = 0; i < shot.extra_source_paths.length; i++) {
        rawSources.push({
          sourcePath: shot.extra_source_paths[i],
          mediaType: "photo",
          inSec: 0,
          outSec: entry.durSec,
          anchor: [0.5, 0.5],
          caption: "",
          dateLabel: "",
        });
      }
    }
  }

  const boxes = libs.Layouts.computeTileBoxes(layoutName, rawSources.length, width, height, style);
  const fitMode = layoutName === "blurred_bg_pillarbox" ? "fit" : "fill";
  const speedModel = entry.speedModel;
  const openStreams = [];

  const preparedSources = rawSources.map((rs, idx) => {
    const box = boxes[Math.min(idx, boxes.length - 1)] || { w: width, h: height };
    if (rs.mediaType === "video") {
      const span = idx === 0 && rawSources.length === 1
        ? speedModel.sourceSpan
        : Math.max(0.2, rs.outSec - rs.inSec, entry.durSec);
      const stream = createVideoStream(rs.sourcePath, {
        startSec: rs.inSec,
        spanSec: span,
        targetW: box.w,
        targetH: box.h,
        fitMode: fitMode,
      });
      openStreams.push(stream);
      return {
        isVideo: true,
        stream: stream,
        inSec: rs.inSec,
        useShotSpeedModel: idx === 0 && rawSources.length === 1,
        anchor: rs.anchor,
        caption: rs.caption,
        dateLabel: rs.dateLabel,
      };
    }
    const maxDim = Math.max(1200, Math.min(2400, Math.max(box.w, box.h) * 1.4));
    return {
      isVideo: false,
      ciImg: loadOrientedCIImage(rs.sourcePath, maxDim),
      anchor: rs.anchor,
      caption: rs.caption,
      dateLabel: rs.dateLabel,
    };
  });

  const lookOverride = shot.look_id || null;

  return {
    renderFrame: function (localFrameIdx, globalFrameIdx) {
      const tOut = localFrameIdx / fps;
      const prog = numFrames > 1 ? localFrameIdx / (numFrames - 1) : 0.0;
      let currentSpeed = 1.0;

      const frameSources = preparedSources.map((ps) => {
        if (!ps.isVideo) {
          return {
            ciImg: ps.ciImg,
            isVideo: false,
            anchor: ps.anchor,
            caption: ps.caption,
            dateLabel: ps.dateLabel,
          };
        }
        let targetPts = ps.inSec + tOut;
        if (ps.useShotSpeedModel) {
          const ev = speedModel.evalAt(tOut);
          targetPts = ev.sourceTime;
          currentSpeed = ev.speed;
        }
        const vidCI = ps.stream.frameAt(targetPts);
        return {
          ciImg: vidCI || $.CIImage.imageWithColor($.CIColor.colorWithRedGreenBlueAlpha(0.05, 0.05, 0.07, 1.0)).imageByCroppingToRect($.CGRectMake(0, 0, width, height)),
          isVideo: true,
          anchor: ps.anchor,
          caption: ps.caption,
          dateLabel: ps.dateLabel,
        };
      });

      let frame = libs.Layouts.renderLayoutFrame(layoutName, frameSources, {
        width: width,
        height: height,
        progress: prog,
        frameIdx: globalFrameIdx,
        fps: fps,
        style: style,
        shot: shot,
      });

      // Velocity-scaled CIMotionBlur during fast speed-ramp phases (v > 1.5x)
      if (currentSpeed > 1.5) {
        const mb = $.CIFilter.filterWithName("CIMotionBlur");
        if (mb) {
          const rad = Math.min(12.0, (currentSpeed - 1.0) * 3.2);
          mb.setValueForKey(frame.imageByClampingToExtent, "inputImage");
          mb.setValueForKey(rad, "inputRadius");
          mb.setValueForKey(0.0, "inputAngle");
          frame = mb.outputImage.imageByCroppingToRect($.CGRectMake(0, 0, width, height));
        }
      }

      frame = libs.StyleEngine.applyStyleGrade(frame, style, lookOverride);
      return frame.imageByCroppingToRect($.CGRectMake(0, 0, width, height));
    },
    close: function () {
      for (let i = 0; i < openStreams.length; i++) openStreams[i].close();
    },
  };
}

// =========================================================================
// PIXEL BUFFER RENDERING & VIDEO-ONLY WRITER (LIVE MOVING TRANSITION LOOKAHEAD)
// =========================================================================
function applyFadeOverlay(ciImg, localF, totalF, fps, fadeInSec, fadeOutSec, width, height) {
  const t = localF / fps;
  const dur = totalF / fps;
  let alpha = 1.0;
  if (fadeInSec > 0 && t < fadeInSec) alpha = Math.min(alpha, t / fadeInSec);
  if (fadeOutSec > 0 && dur - t < fadeOutSec) alpha = Math.min(alpha, Math.max(0.0, (dur - t) / fadeOutSec));
  if (alpha >= 0.999) return ciImg;

  const dark = $.CIFilter.filterWithName("CIColorControls");
  dark.setValueForKey(ciImg, "inputImage");
  dark.setValueForKey(-(1.0 - alpha), "inputBrightness");
  return dark.outputImage.imageByCroppingToRect($.CGRectMake(0, 0, width, height));
}

function allocPixelBuffer(width, height) {
  const pbRef = Ref();
  const attrs = $.NSMutableDictionary.dictionary;
  attrs.setObjectForKey($.NSNumber.numberWithBool(true), "CGImageCompatibility");
  attrs.setObjectForKey($.NSNumber.numberWithBool(true), "CGBitmapContextCompatibility");
  $.CVPixelBufferCreate($.kCFAllocatorDefault, width, height, 1111970369, attrs, pbRef);
  if (!pbRef[0]) throw new Error("Failed to allocate CVPixelBuffer");
  return pbRef[0];
}

function renderCIImageToPixelBuffer(ciCtx, ciImg, pb, width, height, colorSpace709) {
  const rect = $.CGRectMake(0, 0, width, height);
  if (ciCtx && typeof ciCtx.renderToCVPixelBufferBoundsColorSpace === "function" && colorSpace709) {
    ciCtx.renderToCVPixelBufferBoundsColorSpace(ciImg, pb, rect, colorSpace709);
    return;
  }
  if (ciCtx && typeof ciCtx.renderToCVPixelBuffer === "function") {
    ciCtx.renderToCVPixelBuffer(ciImg, pb);
    return;
  }
  // Fallback CPU rasterization via NSCIImageRep
  $.CVPixelBufferLockBaseAddress(pb, 0);
  const base = $.CVPixelBufferGetBaseAddress(pb);
  const bpr = $.CVPixelBufferGetBytesPerRow(pb);
  const cgCtx = $.CGBitmapContextCreate(base, width, height, 8, bpr, colorSpace709, 8194);
  if (cgCtx) {
    const rep = $.NSCIImageRep.imageRepWithCIImage(ciImg);
    const nsGfx = $.NSGraphicsContext.graphicsContextWithCGContextFlipped(cgCtx, false);
    $.NSGraphicsContext.saveGraphicsState;
    $.NSGraphicsContext.setCurrentContext(nsGfx);
    rep.drawInRect($.NSMakeRect(0, 0, width, height));
    $.NSGraphicsContext.restoreGraphicsState;
  }
  $.CVPixelBufferUnlockBaseAddress(pb, 0);
}

function microYield(frameIdx) {
  if (frameIdx % 2 === 0) {
    $.NSThread.sleepForTimeInterval(0.005);
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.001));
  }
}

function appendVideoFrames(shotsSlice, totalEdlCount, startOffset, style, libs, adaptor, videoInput, ciCtx, width, height, fps, logPath) {
  const colorSpace709 = $.CGColorSpaceCreateWithName($.kCGColorSpaceITUR_709) || $.CGColorSpaceCreateDeviceRGB();
  const timeline = computeTimeline(shotsSlice, style, fps, libs.Transitions);
  const entries = timeline.entries;
  let globalFrame = 0;

  function writeFrame(ciFrame) {
    while (!videoInput.readyForMoreMediaData) $.NSThread.sleepForTimeInterval(0.004);
    const pb = allocPixelBuffer(width, height);
    renderCIImageToPixelBuffer(ciCtx, ciFrame, pb, width, height, colorSpace709);
    adaptor.appendPixelBufferWithPresentationTime(pb, $.CMTimeMake(globalFrame, fps));
    $.CVPixelBufferRelease(pb);
    microYield(globalFrame);
    globalFrame++;
  }

  let currProducer = null;

  for (let i = 0; i < entries.length; i++) {
    const entry = entries[i];
    const shot = entry.shot;
    const sIdx = startOffset + i;
    const mtype = shot.media_type || "photo";
    const fadeIn = shot.fade_in !== undefined ? Number(shot.fade_in) : (entry.overlapInFrames === 0 && (mtype === "graphic" || sIdx === 0) ? 0.35 : 0.0);
    const fadeOut = shot.fade_out !== undefined ? Number(shot.fade_out) : (entry.overlapOutFrames === 0 && (mtype === "graphic" || sIdx === totalEdlCount - 1) ? 0.35 : 0.0);

    if (!currProducer) {
      currProducer = createShotProducer(entry, style, libs, width, height, fps);
    }

    logProgress(
      logPath,
      "[shot " + (i + 1) + "/" + entries.length + " (global " + (sIdx + 1) + "/" + totalEdlCount + ")] " +
      (shot.shot_id || mtype) + " (" + entry.numFrames + "f, transOut=" + entry.transOut.type + ":" + entry.overlapOutFrames + "f)"
    );

    // 1. Render solo body of Shot i (excluding frames already blended in incoming/outgoing transitions)
    const soloStart = entry.overlapInFrames;
    const soloEnd = entry.numFrames - entry.overlapOutFrames;
    for (let f = soloStart; f < soloEnd; f++) {
      let ciFrame = currProducer.renderFrame(f, globalFrame);
      if (mtype !== "graphic") {
        ciFrame = libs.StyleEngine.applyStyleTextures(ciFrame, globalFrame, width, height, style, fps);
      }
      ciFrame = applyFadeOverlay(ciFrame, f, entry.numFrames, fps, fadeIn, fadeOut, width, height);
      writeFrame(ciFrame);
    }

    // 2. Live Moving-Buffer Transition Lookahead into Shot i+1
    if (entry.overlapOutFrames > 0 && i < entries.length - 1) {
      const nextEntry = entries[i + 1];
      const nextProducer = createShotProducer(nextEntry, style, libs, width, height, fps);
      const ovCount = entry.overlapOutFrames;

      for (let k = 0; k < ovCount; k++) {
        const fA = (entry.numFrames - ovCount) + k;
        const fB = k;
        const p = (k + 0.5) / ovCount;

        // BOTH Shot A tail and Shot B head advance live every frame!
        const frameA = currProducer.renderFrame(fA, globalFrame);
        const frameB = nextProducer.renderFrame(fB, globalFrame);
        let blended = libs.Transitions.applyTransition(frameA, frameB, p, entry.transOut, width, height, style);
        if (mtype !== "graphic" || (nextEntry.shot.media_type || "photo") !== "graphic") {
          blended = libs.StyleEngine.applyStyleTextures(blended, globalFrame, width, height, style, fps);
        }
        writeFrame(blended);
      }

      currProducer.close();
      currProducer = nextProducer;
    } else {
      currProducer.close();
      currProducer = null;
    }
  }

  if (currProducer) currProducer.close();
  return globalFrame / fps;
}

function renderVideoOnly(shotsSlice, totalEdlCount, startOffset, style, libs, outPath, width, height, fps, logPath) {
  ensureParentDir(outPath);
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(outPath)) fm.removeItemAtPathError(outPath, null);

  const AVAssetWriter = avClass("AVAssetWriter");
  const AVAssetWriterInput = avClass("AVAssetWriterInput");
  const AVAssetWriterInputPixelBufferAdaptor = avClass("AVAssetWriterInputPixelBufferAdaptor");

  const writer = AVAssetWriter.assetWriterWithURLFileTypeError($.NSURL.fileURLWithPath(outPath), $.AVFileTypeMPEG4, null);
  const compProps = $.NSMutableDictionary.dictionary;
  const bitrate = width * height > 2500000 ? 24000000 : 14000000;
  compProps.setObjectForKey($.NSNumber.numberWithInt(bitrate), $.AVVideoAverageBitRateKey);

  const videoSettings = $.NSMutableDictionary.dictionary;
  videoSettings.setObjectForKey($.AVVideoCodecTypeH264, $.AVVideoCodecKey);
  videoSettings.setObjectForKey($.NSNumber.numberWithInt(width), $.AVVideoWidthKey);
  videoSettings.setObjectForKey($.NSNumber.numberWithInt(height), $.AVVideoHeightKey);
  videoSettings.setObjectForKey(compProps, $.AVVideoCompressionPropertiesKey);

  const videoInput = AVAssetWriterInput.assetWriterInputWithMediaTypeOutputSettings($.AVMediaTypeVideo, videoSettings);
  videoInput.expectsMediaDataInRealTime = false;

  const pbAttrs = $.NSMutableDictionary.dictionary;
  pbAttrs.setObjectForKey($.NSNumber.numberWithUnsignedInt(1111970369), "PixelFormatType");
  pbAttrs.setObjectForKey($.NSNumber.numberWithInt(width), "Width");
  pbAttrs.setObjectForKey($.NSNumber.numberWithInt(height), "Height");
  const adaptor = AVAssetWriterInputPixelBufferAdaptor.assetWriterInputPixelBufferAdaptorWithAssetWriterInputSourcePixelBufferAttributes(
    videoInput,
    pbAttrs
  );

  writer.addInput(videoInput);
  writer.startWriting;
  writer.startSessionAtSourceTime($.kCMTimeZero);

  // Disable intermediate CoreImage caching to guarantee flat peak RSS across video batches
  const ciOpts = $.NSMutableDictionary.dictionary;
  ciOpts.setObjectForKey($.NSNumber.numberWithBool(false), $.kCIContextCacheIntermediates);
  const ciCtx = $.CIContext.contextWithOptions(ciOpts);

  const renderedDur = appendVideoFrames(shotsSlice, totalEdlCount, startOffset, style, libs, adaptor, videoInput, ciCtx, width, height, fps, logPath);
  videoInput.markAsFinished;

  logProgress(logPath, "Finishing AVAssetWriter (" + renderedDur.toFixed(2) + "s) -> " + outPath);
  writer.finishWritingWithCompletionHandler(function () {});
  while (Number(writer.status) === 1) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }

  if (Number(writer.status) !== 2) {
    const errMsg = writer.error ? ObjC.unwrap(writer.error.localizedDescription) : ("status=" + Number(writer.status));
    throw new Error("Video-only AVAssetWriter failed: " + errMsg);
  }
  return renderedDur;
}

// =========================================================================
// 2-STEP LOSSLESS 4-TRACK AUDIO MUX (NAT_A / NAT_B / BGM / SFX -> M4A -> PASSTHROUGH)
// =========================================================================
function mergeIntervals(intervals) {
  if (!intervals || intervals.length === 0) return [];
  const sorted = intervals.slice().sort((a, b) => a.start - b.start);
  const merged = [Object.assign({}, sorted[0])];
  for (let i = 1; i < sorted.length; i++) {
    const cur = sorted[i];
    const last = merged[merged.length - 1];
    if (cur.start <= last.end + 0.5) {
      last.end = Math.max(last.end, cur.end);
      last.duckDb = Math.min(last.duckDb, cur.duckDb);
    } else {
      merged.push(Object.assign({}, cur));
    }
  }
  return merged;
}

function resolveShotAudioSource(shot) {
  const mtype = shot.media_type || "photo";
  if (Array.isArray(shot.tiles) && shot.tiles.length > 0) {
    if (shot.audio_lead_tile === -1) return null;
    let leadTile = null;
    if (typeof shot.audio_lead_tile === "number" && shot.audio_lead_tile >= 0 && shot.audio_lead_tile < shot.tiles.length) {
      leadTile = shot.tiles[shot.audio_lead_tile];
    } else {
      for (let i = 0; i < shot.tiles.length; i++) {
        if (shot.tiles[i].audio_lead) {
          leadTile = shot.tiles[i];
          break;
        }
      }
    }
    if (!leadTile || leadTile.media_type !== "video" || !leadTile.source_path) return null;
    return {
      path: leadTile.source_path,
      inSec: Number(leadTile.in_sec || 0),
    };
  }
  if (mtype === "video" && shot.source_path) {
    return {
      path: shot.source_path,
      inSec: Number(shot.in_sec || 0),
    };
  }
  return null;
}

function runExportSession(comp, preset, fileType, outPath, audioMix) {
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(outPath)) fm.removeItemAtPathError(outPath, null);
  const AVAssetExportSession = avClass("AVAssetExportSession");
  const AVMutableAudioMix = avClass("AVMutableAudioMix");

  const exporter = AVAssetExportSession.exportSessionWithAssetPresetName(comp, preset);
  if (!exporter) throw new Error("Failed to create AVAssetExportSession for preset: " + ObjC.unwrap(preset));
  exporter.outputURL = $.NSURL.fileURLWithPath(outPath);
  exporter.outputFileType = fileType;
  exporter.shouldOptimizeForNetworkUse = true;
  if (audioMix && Number(audioMix.count) > 0) {
    const mix = AVMutableAudioMix.audioMix;
    mix.inputParameters = audioMix;
    exporter.audioMix = mix;
  }

  exporter.exportAsynchronouslyWithCompletionHandler(function () {});
  while (Number(exporter.status) === 1 || Number(exporter.status) === 2) {
    $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }
  if (Number(exporter.status) !== 3) {
    const errDesc = exporter.error ? ObjC.unwrap(exporter.error.localizedDescription) : ("status=" + Number(exporter.status));
    throw new Error("AVAssetExportSession (" + ObjC.unwrap(preset) + ") failed: " + errDesc);
  }
}

function muxSegmentsAndAudio(edl, style, libs, segmentPaths, finalOutputPath, fps, logPath) {
  ensureParentDir(finalOutputPath);
  const fm = $.NSFileManager.defaultManager;

  const AVMutableComposition = avClass("AVMutableComposition");
  const AVURLAsset = avClass("AVURLAsset");
  const AVMutableAudioMixInputParameters = avClass("AVMutableAudioMixInputParameters");

  // Measure total concatenated video duration first
  let totalDurSec = 0.0;
  for (let i = 0; i < segmentPaths.length; i++) {
    const segAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(segmentPaths[i]), $({}));
    totalDurSec += $.CMTimeGetSeconds(segAsset.duration);
  }
  if (totalDurSec <= 0.05) throw new Error("Concatenated video segments have zero duration.");

  // ---- STEP 1: Build 4-Track Audio-Only Composition (NAT_A, NAT_B, BGM, SFX) -> AppleM4A ----
  const audioComp = AVMutableComposition.composition;
  const mixParams = $.NSMutableArray.array;
  const styleAudio = (style && style.audio) || {};
  const bgmPath = edl.bgm_path || (edl.bgm && edl.bgm.audio_path) || null;
  const hasBgm = Boolean(bgmPath && fm.fileExistsAtPath(bgmPath));

  const timeline = computeTimeline(edl.shots || [], style, fps, libs.Transitions);
  const natTrackA = audioComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
  const natTrackB = audioComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
  const natParamsA = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(natTrackA);
  const natParamsB = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(natTrackB);
  let natEndA = 0.0;
  let natEndB = 0.0;
  let natUsedA = false;
  let natUsedB = false;
  let natChannelToggle = 0;

  const duckWindows = [];
  const sfxCues = [];

  for (let i = 0; i < timeline.entries.length; i++) {
    const entry = timeline.entries[i];
    const shot = entry.shot;
    const aCfg = shot.audio || {};
    const isSonic = Boolean(aCfg.sonic_postcard || shot.audio_mode === "sonic_postcard");
    const duckDb = Number(aCfg.duck_db !== undefined ? aCfg.duck_db : (styleAudio.duck_bgm_db || -13.0));

    if (aCfg.sfx_path && fm.fileExistsAtPath(aCfg.sfx_path)) {
      sfxCues.push({
        path: aCfg.sfx_path,
        timeSec: Math.max(0.0, entry.endSec + Number(aCfg.sfx_offset_sec || 0.0)),
        volume: 0.45,
      });
    }

    const srcInfo = resolveShotAudioSource(shot);
    const autoMuteRamp = entry.speedModel.peakSpeed > 1.3 && !isSonic;
    if (!srcInfo || aCfg.mute === true || shot.audio_mode === "muted" || autoMuteRamp || !fm.fileExistsAtPath(srcInfo.path)) {
      continue;
    }

    const asset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(srcInfo.path), $({}));
    const aTracks = asset.tracksWithMediaType($.AVMediaTypeAudio);
    if (!aTracks || Number(aTracks.count) === 0) continue;

    const assetDur = $.CMTimeGetSeconds(asset.duration);
    const jCut = Math.max(0.0, Math.min(Number(aCfg.j_cut_sec || 0.0), srcInfo.inSec, entry.startSec));
    const lCut = Math.max(0.0, Number(aCfg.l_cut_sec || 0.0));

    // Checkerboard alternating clips across NAT_A and NAT_B so J/L overlaps never collide
    const useA = natChannelToggle % 2 === 0;
    natChannelToggle++;
    const track = useA ? natTrackA : natTrackB;
    const params = useA ? natParamsA : natParamsB;
    const prevTrackEnd = useA ? natEndA : natEndB;

    const desiredStart = Math.max(prevTrackEnd + 0.02, entry.startSec - jCut);
    const actualJ = Math.max(0.0, entry.startSec - desiredStart);
    const srcStart = Math.max(0.0, srcInfo.inSec - actualJ);
    const desiredEnd = Math.min(totalDurSec, entry.endSec + lCut);
    const clipDur = Math.min(desiredEnd - desiredStart, Math.max(0.0, assetDur - srcStart));
    if (clipDur < 0.08) continue;

    const srcRange = $.CMTimeRangeMake($.CMTimeMakeWithSeconds(srcStart, 600), $.CMTimeMakeWithSeconds(clipDur, 600));
    track.insertTimeRangeOfTrackAtTimeError(srcRange, aTracks.objectAtIndex(0), $.CMTimeMakeWithSeconds(desiredStart, 600), null);

    const baseNatVol = aCfg.volume !== undefined
      ? Number(aCfg.volume)
      : (isSonic ? 0.96 : (hasBgm ? Number(styleAudio.default_nat_bed_volume || 0.25) : 0.85));

    const fadeIn = Math.min(clipDur * 0.35, actualJ > 0.05 ? 0.35 : 0.12);
    const fadeOut = Math.min(clipDur * 0.35, lCut > 0.05 ? 0.45 : 0.14);
    if (fadeIn > 0.02) {
      params.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
        0.0,
        baseNatVol,
        $.CMTimeRangeMake($.CMTimeMakeWithSeconds(desiredStart, 600), $.CMTimeMakeWithSeconds(fadeIn, 600))
      );
    } else {
      params.setVolumeAtTime(baseNatVol, $.CMTimeMakeWithSeconds(desiredStart, 600));
    }
    if (fadeOut > 0.02) {
      params.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
        baseNatVol,
        0.0,
        $.CMTimeRangeMake($.CMTimeMakeWithSeconds(desiredStart + clipDur - fadeOut, 600), $.CMTimeMakeWithSeconds(fadeOut, 600))
      );
    }

    if (useA) {
      natEndA = desiredStart + clipDur;
      natUsedA = true;
    } else {
      natEndB = desiredStart + clipDur;
      natUsedB = true;
    }

    if (isSonic) {
      duckWindows.push({ start: desiredStart, end: desiredStart + clipDur, duckDb: duckDb });
    }
  }

  if (natUsedA) mixParams.addObject(natParamsA);
  else audioComp.removeTrack(natTrackA);
  if (natUsedB) mixParams.addObject(natParamsB);
  else audioComp.removeTrack(natTrackB);

  // Track 3: BGM with smooth Sonic Postcard (-13 dB) volume ramps & end fade-out
  if (hasBgm) {
    const bgmAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(bgmPath), $({}));
    const bgmTracks = bgmAsset.tracksWithMediaType($.AVMediaTypeAudio);
    if (bgmTracks && Number(bgmTracks.count) > 0) {
      const bgmSrc = bgmTracks.objectAtIndex(0);
      const bgmDur = $.CMTimeGetSeconds(bgmAsset.duration);
      const bgmTrack = audioComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
      let filled = 0.0;
      while (filled < totalDurSec && bgmDur > 0.1) {
        const segDur = Math.min(bgmDur, totalDurSec - filled);
        bgmTrack.insertTimeRangeOfTrackAtTimeError(
          $.CMTimeRangeMake($.kCMTimeZero, $.CMTimeMakeWithSeconds(segDur, 600)),
          bgmSrc,
          $.CMTimeMakeWithSeconds(filled, 600),
          null
        );
        filled += segDur;
      }

      const bgmParams = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(bgmTrack);
      const bgmVol = Number((edl.bgm && edl.bgm.volume) || styleAudio.default_bgm_volume || 0.72);
      const endFadeDur = totalDurSec > 2.5 ? 1.8 : Math.min(0.8, totalDurSec * 0.4);
      const endFadeStart = Math.max(0.0, totalDurSec - endFadeDur);

      bgmParams.setVolumeAtTime(bgmVol, $.kCMTimeZero);

      const mergedDucks = mergeIntervals(duckWindows);
      let cursor = 0.0;
      for (let d = 0; d < mergedDucks.length; d++) {
        const w = mergedDucks[d];
        const duckLinear = Math.max(0.03, bgmVol * Math.pow(10.0, (w.duckDb || -13.0) / 20.0));
        const downStart = Math.max(cursor, w.start - 0.45);
        const downEnd = Math.min(endFadeStart, Math.max(downStart + 0.05, w.start));
        const holdEnd = Math.min(endFadeStart, Math.max(downEnd, w.end));
        const upEnd = Math.min(endFadeStart, holdEnd + 0.75);

        if (downEnd > downStart + 0.02) {
          bgmParams.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
            bgmVol,
            duckLinear,
            $.CMTimeRangeMake($.CMTimeMakeWithSeconds(downStart, 600), $.CMTimeMakeWithSeconds(downEnd - downStart, 600))
          );
        } else {
          bgmParams.setVolumeAtTime(duckLinear, $.CMTimeMakeWithSeconds(downStart, 600));
        }
        if (upEnd > holdEnd + 0.02) {
          bgmParams.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
            duckLinear,
            bgmVol,
            $.CMTimeRangeMake($.CMTimeMakeWithSeconds(holdEnd, 600), $.CMTimeMakeWithSeconds(upEnd - holdEnd, 600))
          );
        }
        cursor = upEnd;
      }

      if (endFadeDur > 0.05) {
        bgmParams.setVolumeRampFromStartVolumeToEndVolumeTimeRange(
          bgmVol,
          0.0,
          $.CMTimeRangeMake($.CMTimeMakeWithSeconds(endFadeStart, 600), $.CMTimeMakeWithSeconds(endFadeDur, 600))
        );
      }
      mixParams.addObject(bgmParams);
    }
  }

  // Track 4: Optional SFX track
  if (Array.isArray(edl.sfx_events)) {
    for (let i = 0; i < edl.sfx_events.length; i++) {
      const ev = edl.sfx_events[i];
      if (ev && ev.path && fm.fileExistsAtPath(ev.path)) {
        sfxCues.push({
          path: ev.path,
          timeSec: Math.max(0.0, Number(ev.time_sec || 0) - Number(ev.peak_offset_sec || 0)),
          volume: Number(ev.volume || 0.45),
        });
      }
    }
  }
  if (sfxCues.length > 0) {
    sfxCues.sort((a, b) => a.timeSec - b.timeSec);
    const sfxTrack = audioComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
    const sfxParams = AVMutableAudioMixInputParameters.audioMixInputParametersWithTrack(sfxTrack);
    let sfxCursor = 0.0;
    let sfxInserted = false;
    for (let i = 0; i < sfxCues.length; i++) {
      const cue = sfxCues[i];
      if (cue.timeSec >= totalDurSec - 0.05) continue;
      const startAt = Math.max(sfxCursor + 0.02, cue.timeSec);
      const sfxAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(cue.path), $({}));
      const sTracks = sfxAsset.tracksWithMediaType($.AVMediaTypeAudio);
      if (!sTracks || Number(sTracks.count) === 0) continue;
      const sDur = Math.min($.CMTimeGetSeconds(sfxAsset.duration), totalDurSec - startAt);
      if (sDur < 0.03) continue;
      sfxTrack.insertTimeRangeOfTrackAtTimeError(
        $.CMTimeRangeMake($.kCMTimeZero, $.CMTimeMakeWithSeconds(sDur, 600)),
        sTracks.objectAtIndex(0),
        $.CMTimeMakeWithSeconds(startAt, 600),
        null
      );
      sfxParams.setVolumeAtTime(cue.volume, $.CMTimeMakeWithSeconds(startAt, 600));
      sfxCursor = startAt + sDur;
      sfxInserted = true;
    }
    if (sfxInserted) mixParams.addObject(sfxParams);
    else audioComp.removeTrack(sfxTrack);
  }

  let mixedAudioPath = null;
  if (Number(mixParams.count) > 0) {
    mixedAudioPath = finalOutputPath + ".audio_mix_tmp.m4a";
    logProgress(logPath, "Step 1/2: Exporting 4-track audio mix via AVAssetExportPresetAppleM4A -> " + mixedAudioPath);
    runExportSession(audioComp, $.AVAssetExportPresetAppleM4A, $.AVFileTypeAppleM4A, mixedAudioPath, mixParams);
  }

  // ---- STEP 2: Lossless Video+Audio Passthrough Mux (ZERO video re-encode!) ----
  const finalComp = AVMutableComposition.composition;
  const vCompTrack = finalComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeVideo, 0);
  let videoCursor = $.kCMTimeZero;
  for (let i = 0; i < segmentPaths.length; i++) {
    const segAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(segmentPaths[i]), $({}));
    const vTracks = segAsset.tracksWithMediaType($.AVMediaTypeVideo);
    if (!vTracks || Number(vTracks.count) === 0) throw new Error("Segment has no video track: " + segmentPaths[i]);
    vCompTrack.insertTimeRangeOfTrackAtTimeError(
      $.CMTimeRangeMake($.kCMTimeZero, segAsset.duration),
      vTracks.objectAtIndex(0),
      videoCursor,
      null
    );
    videoCursor = $.CMTimeAdd(videoCursor, segAsset.duration);
  }

  if (mixedAudioPath && fm.fileExistsAtPath(mixedAudioPath)) {
    const m4aAsset = AVURLAsset.URLAssetWithURLOptions($.NSURL.fileURLWithPath(mixedAudioPath), $({}));
    const m4aTracks = m4aAsset.tracksWithMediaType($.AVMediaTypeAudio);
    if (m4aTracks && Number(m4aTracks.count) > 0) {
      const aCompTrack = finalComp.addMutableTrackWithMediaTypePreferredTrackID($.AVMediaTypeAudio, 0);
      const audioDur = $.CMTimeMinimum(m4aAsset.duration, videoCursor);
      aCompTrack.insertTimeRangeOfTrackAtTimeError(
        $.CMTimeRangeMake($.kCMTimeZero, audioDur),
        m4aTracks.objectAtIndex(0),
        $.kCMTimeZero,
        null
      );
    }
  }

  logProgress(logPath, "Step 2/2: Lossless Passthrough mux (" + $.CMTimeGetSeconds(videoCursor).toFixed(2) + "s) -> " + finalOutputPath);
  runExportSession(finalComp, $.AVAssetExportPresetPassthrough, $.AVFileTypeMPEG4, finalOutputPath, null);

  if (mixedAudioPath && fm.fileExistsAtPath(mixedAudioPath)) {
    fm.removeItemAtPathError(mixedAudioPath, null);
  }
  return $.CMTimeGetSeconds(videoCursor);
}

// =========================================================================
// MAIN ENTRYPOINT
// =========================================================================
function run(argv) {
  const args = parseArgs(argv);
  if (args.help) {
    return JSON.stringify({
      version: "0.2.0",
      usage: "osascript -l JavaScript macos_render_trip.jxa --edl ./work/edl.json --output <out.mp4> [--style-id <id>] [--styles-dir <dir>] [--start-shot 0 --end-shot 6 --video-only] [--mux-segments s1.mp4,s2.mp4] [--width 1920] [--height 1080] [--fps 30] [--dry-run]",
      capabilities: [
        "7 Style Packs (lib/style_engine.js)",
        "7 Single & Multi-Video Layouts (lib/layouts.js)",
        "10 Live Moving-Buffer Transitions (lib/transitions.js)",
        "6 Style-Aware Graphic Cards + Synced Elevation Profile (lib/cards.js)",
        "Unified Rec.709 Hardware Video Decoder (AVAssetReaderVideoCompositionOutput)",
        "Closed-Form Piecewise Cubic Speed Ramping",
        "2-Step Lossless 4-Track J/L-Cut + Sonic Postcard Audio Mux (AppleM4A -> Passthrough)",
      ],
    }, null, 2);
  }
  if (!args.edl) throw new Error("Missing --edl <edl.json>.");

  const scriptDir = resolveScriptDir();
  const libs = loadNativeLibs(scriptDir);
  const edl = readJsonFile(args.edl);
  const allShots = edl.shots || [];
  if (allShots.length === 0) throw new Error("EDL has no shots.");

  const stylesDir = args.stylesDir || ObjC.unwrap($(scriptDir + "/../../styles").stringByStandardizingPath);
  const styleId = args.styleId || edl.style_id || "cinema_doc";
  const legacyLook = edl.look_id || edl.color_look || null;
  const style = libs.StyleEngine.loadStylePack(styleId, stylesDir, legacyLook, edl.style_overrides);

  const dims = resolveCanvasDims(args, edl);
  const startIdx = args.startShot !== null ? Math.max(0, args.startShot) : 0;
  const endIdx = args.endShot !== null ? Math.min(allShots.length, args.endShot) : allShots.length;
  const shotsSlice = allShots.slice(startIdx, endIdx);
  const timeline = computeTimeline(shotsSlice, style, dims.fps, libs.Transitions);

  if (args.dryRun) {
    const transitionCount = timeline.entries.filter((e) => e.overlapOutFrames > 0).length;
    const speedRampCount = timeline.entries.filter((e) => e.speedModel.mode === "cubic_ramp" || (e.speedModel.mode === "constant" && Math.abs(e.speedModel.peakSpeed - 1.0) > 0.05)).length;
    const multiVideoCount = shotsSlice.filter((s) => Array.isArray(s.tiles) && s.tiles.length >= 2).length;
    const sonicPostcards = shotsSlice.filter((s) => (s.audio && s.audio.sonic_postcard) || s.audio_mode === "sonic_postcard").length;
    return JSON.stringify({
      status: "dry_run",
      version: "0.2.0",
      renderer: "macos-native-avfoundation-jxa-v2",
      output: args.output,
      mode: args.muxSegments ? "mux_segments" : (args.videoOnly ? "video_only_slice" : "full_render"),
      aspect_profile: edl.aspect_profile || (dims.height > dims.width ? "9:16" : "16:9"),
      resolution: dims.width + "x" + dims.height,
      fps: dims.fps,
      style_id: style.style_id,
      style_display_name: style.display_name,
      styles_dir: stylesDir,
      start_shot: startIdx,
      end_shot: endIdx,
      shot_count: shotsSlice.length,
      estimated_duration_sec: Number(timeline.totalDurSec.toFixed(2)),
      overlap_transitions: transitionCount,
      speed_ramped_shots: speedRampCount,
      multi_source_grid_shots: multiVideoCount,
      sonic_postcards: sonicPostcards,
      libs_loaded: ["style_engine.js", "layouts.js", "transitions.js", "cards.js"],
    }, null, 2);
  }

  const logPath = args.output + ".progress.log";
  const fm = $.NSFileManager.defaultManager;
  if (fm.fileExistsAtPath(logPath)) fm.removeItemAtPathError(logPath, null);

  if (args.muxSegments && args.muxSegments.length > 0) {
    const dur = muxSegmentsAndAudio(edl, style, libs, args.muxSegments, args.output, dims.fps, logPath);
    return JSON.stringify({
      status: "muxed",
      version: "0.2.0",
      renderer: "macos-native-avfoundation-jxa-v2",
      output: args.output,
      style_id: style.style_id,
      segment_count: args.muxSegments.length,
      duration_sec: Number(dur.toFixed(2)),
    }, null, 2);
  }

  if (args.videoOnly) {
    const dur = renderVideoOnly(shotsSlice, allShots.length, startIdx, style, libs, args.output, dims.width, dims.height, dims.fps, logPath);
    return JSON.stringify({
      status: "rendered_video_only",
      version: "0.2.0",
      renderer: "macos-native-avfoundation-jxa-v2",
      output: args.output,
      style_id: style.style_id,
      resolution: dims.width + "x" + dims.height,
      start_shot: startIdx,
      end_shot: endIdx,
      shot_count: shotsSlice.length,
      duration_sec: Number(dur.toFixed(2)),
    }, null, 2);
  }

  const videoTmpPath = args.output + ".video_tmp.mp4";
  const renderedDur = renderVideoOnly(shotsSlice, allShots.length, startIdx, style, libs, videoTmpPath, dims.width, dims.height, dims.fps, logPath);
  muxSegmentsAndAudio(edl, style, libs, [videoTmpPath], args.output, dims.fps, logPath);
  if (fm.fileExistsAtPath(videoTmpPath)) fm.removeItemAtPathError(videoTmpPath, null);

  return JSON.stringify({
    status: "rendered",
    version: "0.2.0",
    renderer: "macos-native-avfoundation-jxa-v2",
    output: args.output,
    style_id: style.style_id,
    resolution: dims.width + "x" + dims.height,
    duration_sec: Number(renderedDur.toFixed(2)),
    shot_count: shotsSlice.length,
  }, null, 2);
}
