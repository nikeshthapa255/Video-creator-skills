{
  "name": "trip-cinema-remotion-template",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-API-key Remotion 16:9 route map and EXIF chapter title overlays for trip-cinema-studio.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:map": "remotion render src/index.ts TripRouteMap out/route_map.mp4",
    "render:title": "remotion render src/index.ts ChapterTitle out/chapter_title.mp4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
