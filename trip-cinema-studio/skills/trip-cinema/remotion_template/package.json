{
  "name": "trip-cinema-remotion-template",
  "version": "0.2.0",
  "private": true,
  "description": "Zero-API-key Remotion 16:9 Style-Pack-aware chapter titles, GPS route + elevation maps, and Trip Wrapped EXIF stat cards for trip-cinema-studio.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:map": "remotion render src/index.ts TripRouteMap out/route_map.mp4",
    "render:title": "remotion render src/index.ts ChapterTitle out/chapter_title.mp4",
    "render:wrapped": "remotion render src/index.ts TripWrappedCard out/trip_wrapped.mp4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
