    "ffmpeg_vf": "eq=contrast=1.02:saturation=1.04:brightness=0.02:gamma=1.06,colorbalance=rs=0.09:gs=0.04:bs=-0.08:rh=0.08:gh=0.03:bh=-0.06"
  },
  "textures": {
