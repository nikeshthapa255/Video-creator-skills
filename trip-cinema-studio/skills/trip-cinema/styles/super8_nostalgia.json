  "best_for": [
    "Summer beach and coastal holidays",
    "Family reunions and anniversaries",
    "Candid trips with kids and elders",
    "Golden-hour nostalgic travel reels"
  ],
  "vibe_tags": ["vintage", "super8", "nostalgic", "warm"],
  "palette": {
    "bg": "#14110E",
    "surface": "#231D17",
    "text_primary": "#F7ECD8",
    "text_secondary": "#CBB89D",
    "accent": "#E88D48",
    "accent_secondary": "#D64531",
    "border": "#090807",
    "swatches": ["#14110E", "#E88D48", "#D64531", "#F7ECD8", "#6B5642"]
  },
  "typography": {
    "display_font": "Georgia-Bold",
